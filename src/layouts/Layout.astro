---
import Navbar from "@/components/layout/Navbar.astro";
import Footer from "@/components/layout/Footer.astro";
import ChatWidget from "@/components/shared/ChatWidget.astro";
import defaultImage from "@/assets/images/test/abdominoplastia.jpg";
import "@/styles/global.css";

import { loadTranslations } from "../lib/i18n";
import { getNavbarData } from "../lib/navbarData";
const lang = Astro.params.lang || "es";
const t = await loadTranslations(lang);

const { api } = Astro.locals;

// Memoized per-language fetcher. First request per TTL window hits the backend;
// subsequent requests reuse the in-process cache. Errors degrade gracefully to
// an empty payload.
const { carousel: images, topProcedure, procedures, settings } = await getNavbarData(api, lang);

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  procedureContext?: string;
}

const {
  title = "AlmhaPlasticSurgery",
  description = "Descripción por defecto",
  keywords = "",
  image = defaultImage.src,
  procedureContext = "",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Almha" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />



    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5G7KLND29N"
    ></script></head
  >

  <!-- Google tag (gtag.js) -->

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(...args) {
      dataLayer.push(args);
    }
    gtag("js", new Date());

    gtag("config", "G-5G7KLND29N");
  </script>

  <body>
    <Navbar
      procedures={procedures}
      settings={settings}
      procedureContext={procedureContext}
    />
    <div id="navbar-spacer" class="bg-[#513A31]"></div>
    <slot />
    <Footer settings={settings} />
    <ChatWidget />

    <!-- Global toast notifications target (used by @/lib/toast) -->
    <div
      id="toast-container"
      class="fixed bottom-6 right-6 z-100 flex flex-col gap-3 pointer-events-none"
    >
    </div>

    <!-- Show a toast when the user lands here from an email confirmation link -->
    <script>
      import { showToast } from "@/lib/toast";

      function handleSubscriptionStatus() {
        const url = new URL(window.location.href);
        const status = url.searchParams.get("subscription");
        if (!status) return;

        const messages: Record<string, { text: string; variant: "success" | "error" }> = {
          confirmed: {
            text: "¡Suscripción confirmada! Pronto recibirás nuestras novedades.",
            variant: "success",
          },
          failed: {
            text: "No pudimos confirmar tu suscripción. El enlace puede haber expirado.",
            variant: "error",
          },
          invalid: {
            text: "El enlace de confirmación no es válido.",
            variant: "error",
          },
        };

        const entry = messages[status];
        if (!entry) return;

        showToast(entry.text, entry.variant);

        // Clean the query param so the toast doesn't reappear on refresh.
        url.searchParams.delete("subscription");
        window.history.replaceState({}, "", url.toString());
      }

      // Run on initial load and on Astro SPA navigation.
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", handleSubscriptionStatus);
      } else {
        handleSubscriptionStatus();
      }
      document.addEventListener("astro:page-load", handleSubscriptionStatus);
    </script>

    <script is:inline>
      function updateNavbarSpacer() {
        const navbar = document.getElementById("main-navbar");
        const spacer = document.getElementById("navbar-spacer");
        if (navbar && spacer) {
          spacer.style.height = navbar.offsetHeight + "px";
        }
      }

      // Ejecutar al cargar y al redimensionar
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", updateNavbarSpacer);
      } else {
        updateNavbarSpacer();
      }
      window.addEventListener("resize", updateNavbarSpacer);
      document.addEventListener("astro:page-load", updateNavbarSpacer);
    </script>


  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
