---
const { image } = Astro.props;
import { getRelativeLocaleUrl } from "astro:i18n";
import Button from "@/components/ui/Button.astro";
import { loadTranslations } from "@/lib/i18n";

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);

console.log("imagen: ", image);
---

<div class="relative w-full h-screen">
  {
    image && image.length > 0 && (
      <>
        <div class="absolute inset-0">
          <img src={image[0].image} alt="" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-[#513A31]/40" />
        </div>

        <div class="relative z-20 flex h-full flex-col items-center justify-center px-6 text-center">
          <div id="content-container">
            <p class="font-advent mb-6 text-xs font-light tracking-[0.4em] uppercase text-[#FEEBDD]">
              {t?.home?.hero?.badge}
            </p>

            <h1 class="font-advent max-w-4xl text-4xl font-bold leading-tight text-[#FFF9F6] md:text-6xl lg:text-7xl whitespace-pre-line text-balance">
              {image[0].title}
            </h1>

            <p class="font-advent mt-6 max-w-xl text-base font-light leading-relaxed text-[#FEEBDD]/90 md:text-lg">
              {image[0].subtitle}
            </p>

            <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
              <Button href={getRelativeLocaleUrl(currentLang, "procedure")}>
                {t?.home?.hero?.view_plans}
              </Button>
              <Button
                href={getRelativeLocaleUrl(currentLang, "about")}
                variant="secondary"
              >
                {t?.home?.hero?.learn_more}
              </Button>
            </div>
          </div>
        </div>
      </>
    )
  }
</div>
