---
import { Sparkles, Syringe, Zap, Heart } from "@lucide/astro";
import { loadTranslations } from "@/lib/i18n";

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);

const { treatments: propTreatments } = Astro.props;

interface Treatment {
  icon: string;
  title: string;
  description: string;
  features: string[];
}

// Default data in case props are not passed
const defaultTreatments: Treatment[] = [
  {
    icon: "Sparkles",
    title: "Rejuvenecimiento Facial",
    description:
      "Tratamientos avanzados de láser y luz pulsada para restaurar la luminosidad y textura natural de su piel.",
    features: ["Láser fraccionado", "IPL", "Peeling químico", "LED therapy"],
  },
  {
    icon: "Syringe",
    title: "Medicina Estética",
    description:
      "Procedimientos mínimamente invasivos con resultados naturales y tiempo de recuperación mínimo.",
    features: ["Ácido hialurónico", "Botox", "Bioestimuladores", "Mesoterapia"],
  },
  {
    icon: "Zap",
    title: "Remodelación Corporal",
    description:
      "Tecnología de última generación para esculpir y tonificar sin cirugía invasiva.",
    features: [
      "Criolipólisis",
      "Radiofrecuencia",
      "HIFU corporal",
      "Presoterapia",
    ],
  },
  {
    icon: "Heart",
    title: "Bienestar Integral",
    description:
      "Programas personalizados que combinan estética y salud para resultados duraderos.",
    features: [
      "Nutrición estética",
      "Terapia IV",
      "Detox",
      "Medicina regenerativa",
    ],
  },
];

const treatments: Treatment[] =
  propTreatments && propTreatments.length > 0
    ? propTreatments
    : defaultTreatments;

const iconMap: Record<string, any> = {
  Sparkles: Sparkles,
  Syringe: Syringe,
  Zap: Zap,
  Heart: Heart,
};
---

<section id="treatments" class="py-24 md:py-32 bg-background">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <p class="text-sm tracking-[0.3em] text-primary uppercase mb-4">
        {t?.home?.treatments?.badge}
      </p>
      <h2 class="font-serif text-3xl md:text-5xl text-foreground mb-6">
        {t?.home?.treatments?.title}
      </h2>
      <p class="max-w-2xl mx-auto text-muted-foreground">
        {t?.home?.treatments?.description}
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-start">
      {/* Treatment List */}
      <div class="space-y-4">
        {
          treatments.map((treatment, index) => {
            const Icon = iconMap[treatment.icon] || Sparkles;
            const isActive = index === 0;

            return (
              <button
                class="treatment-btn group w-full text-left p-6 transition-all duration-500 border cursor-pointer"
                data-index={index}
                aria-selected={isActive ? "true" : "false"}
              >
                <div class="flex items-start gap-4">
                  <div class="icon-container p-3 transition-colors duration-300">
                    <Icon class="size-6" />
                  </div>
                  <div class="flex-1">
                    <h3 class="font-serif text-xl text-[#513A31] mb-2">
                      {treatment.title}
                    </h3>
                    <p class="desc-preview text-sm transition-all duration-300">
                      {treatment.description}
                    </p>
                  </div>
                  <div class="indicator w-2 h-2 rounded-full transition-colors duration-300 mt-2" />
                </div>
              </button>
            );
          })
        }
      </div>

      {/* Active Treatment Details */}
      <div
        class="lg:sticky lg:top-32 border border-[#D6C4B6] p-8 md:p-12 min-h-[500px] bg-card-manual"
      >
        {
          treatments.map((treatment, index) => {
            const isActive = index === 0;
            return (
              <div
                class:list={[
                  "treatment-detail transition-opacity duration-300",
                  isActive
                    ? "block opacity-100"
                    : "hidden opacity-0 absolute top-8 left-8 right-8 bottom-8 pointer-events-none",
                ]}
                data-index={index}
              >
                <div class="mb-8">
                  <span class="text-xs tracking-[0.3em] text-primary uppercase">
                    {t?.home?.treatments?.specialties_badge}
                  </span>
                </div>
                <h3 class="font-serif text-2xl md:text-3xl text-foreground mb-6">
                  {treatment.title}
                </h3>
                <p class="text-muted-foreground mb-8 leading-relaxed">
                  {treatment.description}
                </p>
                <div class="space-y-4">
                  <p class="text-sm tracking-wider text-foreground uppercase mb-4">
                    {t?.home?.treatments?.includes}
                  </p>
                  <ul class="grid grid-cols-2 gap-3">
                    {(treatment.features || []).map((feature) => (
                      <li class="flex items-center gap-2 text-muted-foreground">
                        <span class="w-1.5 h-1.5 bg-primary rounded-full" />
                        {feature}
                      </li>
                    ))}
                  </ul>
                </div>
                <a
                  href="#contact"
                  class="mt-10 inline-flex px-8 py-4 bg-[#513A31] text-[#FFF9F6] text-sm tracking-wider uppercase hover:bg-primary/90 transition-all duration-300"
                >
                  {t?.home?.treatments?.cta}
                </a>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Manual styles to replace missing utility classes */
  .bg-card-manual {
    background-color: #fff9f6;
  }

  /* Define state styles using aria-selected */
  .treatment-btn[aria-selected="true"] {
    background-color: #fff9f6;
    border-color: rgba(81, 58, 49, 0.2);
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
  }
  .treatment-btn[aria-selected="false"] {
    background-color: transparent;
    border-color: #d6c4b6;
  }
  .treatment-btn[aria-selected="false"]:hover {
    border-color: rgba(81, 58, 49, 0.1);
  }

  /* Inner elements state styles */
  .treatment-btn[aria-selected="true"] .icon-container {
    background-color: #513a31;
    color: #fff9f6;
  }
  .treatment-btn[aria-selected="false"] .icon-container {
    background-color: #f3f4f6;
    color: #6b7280;
  }

  .treatment-btn[aria-selected="true"] .desc-preview {
    color: #71717a;
    opacity: 1;
    max-height: 5rem;
  }
  .treatment-btn[aria-selected="false"] .desc-preview {
    color: rgba(113, 113, 122, 0.7);
    opacity: 0.7;
    max-height: 0;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .treatment-btn[aria-selected="false"] .desc-preview {
      max-height: 5rem;
      opacity: 0.7;
    }
  }

  .treatment-btn[aria-selected="true"] .indicator {
    background-color: #513a31;
  }
  .treatment-btn[aria-selected="false"] .indicator {
    background-color: #e5e7eb;
  }
</style>

<script>
  function initTreatments() {
    const buttons = document.querySelectorAll(".treatment-btn");
    const details = document.querySelectorAll(".treatment-detail");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const index = btn.getAttribute("data-index");

        // Update buttons
        buttons.forEach((b) => {
          const isSelected = b.getAttribute("data-index") === index;
          b.setAttribute("aria-selected", isSelected ? "true" : "false");
        });

        // Update details
        details.forEach((d) => {
          if (d.getAttribute("data-index") === index) {
            d.classList.remove(
              "hidden",
              "opacity-0",
              "absolute",
              "pointer-events-none",
            );
            d.classList.add("block", "opacity-100");
          } else {
            d.classList.add(
              "hidden",
              "opacity-0",
              "absolute",
              "pointer-events-none",
            );
            d.classList.remove("block", "opacity-100");
          }
        });
      });
    });
  }

  // Run on load and potential view transitions
  document.addEventListener("DOMContentLoaded", initTreatments);
  document.addEventListener("astro:page-load", initTreatments);
</script>
