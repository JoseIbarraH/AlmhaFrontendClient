---
import { loadTranslations } from "@/lib/i18n";

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);
---

<section class="w-full bg-[#FFF9F6] py-20 px-6 sm:px-12 lg:px-24 flex items-center justify-center">
  <div
    class="max-w-4xl w-full bg-linear-to-br from-[#513A31] to-[#7D6A5D] rounded-4xl p-10 md:p-16 text-center shadow-2xl relative overflow-hidden"
  >
    <!-- Overlay/Decorative glow -->
    <div class="absolute -top-20 -left-20 w-64 h-64 bg-[#FEEBDD]/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-20 -right-20 w-64 h-64 bg-[#FEEBDD]/10 rounded-full blur-3xl">
    </div>

    <div class="relative z-10 flex flex-col items-center gap-6">
      <!-- Decorative Icon/Element -->
      <div
        class="w-16 h-16 bg-[#FEEBDD] rounded-full flex items-center justify-center shadow-lg mb-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#513A31"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
          ></path>
        </svg>
      </div>

      <h2 class="font-advent text-3xl md:text-5xl font-semibold text-[#FFF9F6] tracking-wide">
        {t?.home?.contact_cta?.title}
      </h2>

      <p class="text-[#FEEBDD]/90 text-lg md:text-xl max-w-2xl font-light leading-relaxed">
        {t?.home?.contact_cta?.description}
      </p>

      <a
        href={`/${currentLang}/contact`}
        class="mt-4 px-10 py-4 bg-[#FEEBDD] text-[#513A31] font-semibold tracking-wide rounded-xl
               hover:scale-[1.05] hover:shadow-xl hover:bg-white active:scale-[0.98]
               transition-all duration-300 inline-flex items-center gap-3"
      >
        <span>{t?.home?.contact_cta?.button}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
