---
import defaultImage from "@/assets/images/test/abdominoplastia.jpg";

interface Props {
  id?: string;
  bg?: string;
  fullScreen?: boolean;
  overlayColor?: string;
}

const {
  id = "default",
  bg = defaultImage.src,
  fullScreen = true,
  overlayColor = "#513A31/50",
} = Astro.props;

const isVideo = (url: string) => {
  if (!url) return false;
  const videoExtensions = [".mp4", ".webm", ".ogg", ".mov", ".avi", ".mkv", ".m4v"];
  return videoExtensions.some((ext) => url.toLowerCase().endsWith(ext));
};

const isVideoBackground = isVideo(bg);
---

<div
  id={id}
  class:list={[
    "parallax-section",
    fullScreen && "parallax-fullscreen",
    !fullScreen && "parallax-short",
  ]}
  style={!isVideoBackground ? `background-image: url(${bg});` : ""}
>
  {
    isVideoBackground && (
      <div class="video-bg">
        <video autoplay muted loop playsinline preload="auto">
          <source src={bg} type={`video/${bg.split(".").pop()}`} />
        </video>
      </div>
    )
  }

  <div class={`absolute inset-0 bg-[${overlayColor}]`}></div>

  <div class="relative z-10 h-full">
    <slot />
  </div>
</div>

<style>
  .parallax-section {
    position: relative;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    /* Esto es todo lo que hace falta — la imagen queda clavada al viewport */
    background-attachment: fixed;
    filter: brightness(0.9);
  }

  .parallax-fullscreen {
    min-height: 500px;
  }

  @media (min-width: 768px) {
    .parallax-fullscreen {
      height: 100vh;
    }
  }

  .parallax-short {
    min-height: 400px;
  }

  /* Video: fixed manual con JS porque background-attachment no aplica a video */
  .video-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  .video-bg video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  video::-webkit-media-controls,
  video::-webkit-media-controls-enclosure {
    display: none !important;
  }
</style>
