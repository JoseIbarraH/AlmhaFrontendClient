---
import Placeholder from "@/assets/images/placeholder/placeholder.png";
import { getRelativeLocaleUrl } from "astro:i18n";
import Button from "@/components/ui/Button.astro";
import { loadTranslations } from "@/lib/i18n";

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);

interface Props {
  slides?: Array<{
    image: string;
    title: string;
    subtitle: string;
  }>;
}

const { slides: userSlides } = Astro.props;

const defaultSlidesRaw = (t?.common?.navbar_carousel?.default_slides ?? []) as Array<{
  title: string;
  subtitle: string;
}>;

const defaultSlides = defaultSlidesRaw.map((slide) => ({
  image: Placeholder.src,
  title: slide.title,
  subtitle: slide.subtitle,
}));

const slides = userSlides && userSlides.length > 0 ? userSlides : defaultSlides;
---

<section
  id="inicio"
  class="relative h-screen w-full overflow-hidden hero-carousel"
  data-slides={JSON.stringify(slides)}
>
  <!-- Slides -->
  {
    slides.map((slide, i) => (
      <div
        class={`absolute inset-0 transition-opacity duration-1000 ease-in-out slide ${i === 0 ? "opacity-100 z-10 active" : "opacity-0 z-0"}`}
        data-index={i}
      >
        <div
          class="absolute inset-0 bg-cover bg-center slide-image"
          style={`background-image: url(${slide.image}); transform: ${i === 0 ? "scale(1.05)" : "scale(1)"}; transition: transform 8s ease-out;`}
        />
        <div class="absolute inset-0 bg-[#513A31]/40" />
      </div>
    ))
  }

  <!-- Content Container -->
  <div
    class="relative z-20 flex h-full flex-col items-center justify-center px-6 text-center"
  >
    <div id="carousel-content">
      <p
        class="font-advent mb-6 text-xs font-light tracking-[0.4em] uppercase text-[#FEEBDD] transition-all delay-200 duration-700 animate-slide-up"
      >
        {t?.home?.hero?.badge}
      </p>

      <!-- Dynamic Title -->
      <h1
        id="hero-title"
        class="font-advent max-w-4xl text-4xl font-bold leading-tight text-[#FFF9F6] md:text-6xl lg:text-7xl whitespace-pre-line text-balance transition-opacity duration-500 ease-in-out"
      >
        {slides[0].title}
      </h1>

      <!-- Dynamic Subtitle -->
      <p
        id="hero-subtitle"
        class="font-advent mt-6 max-w-xl text-base font-light leading-relaxed text-[#FEEBDD]/90 md:text-lg transition-opacity duration-500 ease-in-out"
      >
        {slides[0].subtitle}
      </p>

      <div
        class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
      >
        <Button href={getRelativeLocaleUrl(currentLang, "procedure")}>
          {t?.home?.hero?.view_plans}
        </Button>
        <Button
          href={getRelativeLocaleUrl(currentLang, "about")}
          variant="secondary"
        >
          {t?.home?.hero?.learn_more}
        </Button>
      </div>
    </div>
  </div>

  <!-- Dots -->
  <div class="absolute bottom-10 left-1/2 z-20 flex -translate-x-1/2 gap-3">
    {
      slides.map((_, i) => (
        <button
          aria-label={(t?.common?.navbar_carousel?.go_to_slide ?? "{n}").replace("{n}", String(i + 1))}
          class={`h-[4px] transition-all duration-500 dot ${i === 0 ? "w-10 bg-[#FFF9F6]" : "w-6 bg-[#FFF9F6]/40 hover:bg-[#FFF9F6]/70"}`}
          data-index={i}
        />
      ))
    }
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-10 right-8 z-20 hidden flex-col items-center gap-2 lg:flex"
  >
    <span
      class="font-advent text-[10px] font-light tracking-[0.3em] uppercase text-[#FFF9F6]/60 [writing-mode:vertical-lr]"
    >
      {t?.home?.hero?.scroll}
    </span>
    <div class="h-12 w-px bg-[#FFF9F6]/30">
      <div class="h-4 w-px animate-bounce bg-[#FFF9F6]"></div>
    </div>
  </div>
</section>

<script>
  function initCarousel() {
    const section = document.querySelector(".hero-carousel") as HTMLElement;
    if (!section) return;

    const slidesData = JSON.parse(section.dataset.slides || "[]");

    const slides = section.querySelectorAll(".slide");
    const dots = section.querySelectorAll(".dot");
    const titleEl = document.getElementById("hero-title");
    const subtitleEl = document.getElementById("hero-subtitle");

    let currentIndex = 0;
    let isTransitioning = false;
    let autoPlayInterval: number;

    const updateSlide = (index: number) => {
      // Background Image Transition
      slides.forEach((slide, i) => {
        const slideImg = slide.querySelector(".slide-image") as HTMLElement;
        if (i === index) {
          slide.classList.remove("opacity-0", "z-0");
          slide.classList.add("opacity-100", "z-10", "active");
          if (slideImg) slideImg.style.transform = "scale(1.05)";
        } else {
          slide.classList.remove("opacity-100", "z-10", "active");
          slide.classList.add("opacity-0", "z-0");
          if (slideImg) slideImg.style.transform = "scale(1)";
        }
      });

      // Content Transition (Text)
      if (titleEl && subtitleEl) {
        // Fade out
        titleEl.style.opacity = "0";
        subtitleEl.style.opacity = "0";

        setTimeout(() => {
          // Update Text
          titleEl.textContent = slidesData[index].title;
          subtitleEl.textContent = slidesData[index].subtitle;

          // Fade in
          titleEl.style.opacity = "1";
          subtitleEl.style.opacity = "1";
        }, 500); // Wait for half the transition time
      }

      // Dots Update
      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.remove("w-6", "bg-[#FFF9F6]/40");
          dot.classList.add("w-10", "bg-[#FFF9F6]");
        } else {
          dot.classList.remove("w-10", "bg-[#FFF9F6]");
          dot.classList.add("w-6", "bg-[#FFF9F6]/40");
        }
      });
    };

    const goTo = (index: number) => {
      if (isTransitioning || index === currentIndex) return;
      isTransitioning = true;
      currentIndex = index;

      updateSlide(index);

      setTimeout(() => {
        isTransitioning = false;
      }, 1000); // Match CSS duration
    };

    const nextSlide = () => {
      goTo((currentIndex + 1) % slides.length);
    };

    // Attach click handlers to dots
    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        goTo(i);
        resetAutoPlay();
      });
    });

    const startAutoPlay = () => {
      autoPlayInterval = window.setInterval(nextSlide, 6000); // 6 seconds
    };

    const resetAutoPlay = () => {
      window.clearInterval(autoPlayInterval);
      startAutoPlay();
    };

    // Start
    startAutoPlay();
  }

  // Run on load and on View Transitions if using Astro View Transitions
  document.addEventListener("astro:page-load", initCarousel);
  document.addEventListener("DOMContentLoaded", initCarousel);
</script>
