---
import { loadTranslations } from "@/lib/i18n";
import imagotipo from "@/assets/images/logos/Imagotipo_nombre_beige.png";
import placeholder from "@/assets/images/placeholder/placeholder.png";

interface Props {
  bg?: string | null;
  mediaType?: string | null;
}

const { bg, mediaType } = Astro.props;

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);

const credentials = Object.values(t?.home?.doctor?.credentials || {});

const hasMedia = !!bg && bg.length > 0;
const isVideo = hasMedia && mediaType === "video";
const backgroundUrl = hasMedia ? (bg as string) : placeholder.src;
---

<section class="relative h-screen w-full overflow-hidden">
  {
    isVideo ? (
      <div class="absolute inset-0">
        <video
          src={backgroundUrl}
          class="absolute inset-0 w-full h-full object-cover object-[30%_center] md:object-center"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
        />
        <div class="absolute inset-0 bg-black/20" />
      </div>
    ) : (
      <div
        class="absolute inset-0 bg-cover bg-position-[30%_center] md:bg-center bg-no-repeat"
        style={`background-image: url(${backgroundUrl})`}
      >
        <div class="absolute inset-0 bg-black/20" />
      </div>
    )
  }

  <div
    class="relative z-10 flex flex-col h-full items-center justify-center px-6 py-12 md:items-end md:px-16 lg:px-24 xl:px-32 w-full"
  >
    <div
      class="w-72 sm:w-80 md:w-96 lg:w-120 xl:w-140 flex flex-col gap-3 md:gap-4"
    >
      <img
        src={imagotipo.src}
        alt={t?.common?.logo?.main_alt}
        class="w-full drop-shadow-2xl"
      />
      <h1
        class="wrap-break-word font-advent text-lg sm:text-xl md:text-xl lg:text-2xl text-left md:text-center text-[#FFF9F6]"
      >
        {t?.home?.doctor?.headline}
      </h1>
    </div>
  </div>

  <div
    class="absolute bottom-10 right-8 z-20 hidden flex-col items-center gap-2 lg:flex"
  >
    <span
      class="font-advent text-[10px] font-light tracking-[0.3em] uppercase text-[#FFF9F6]/60 [writing-mode:vertical-lr]"
    >
      {t?.home?.hero?.scroll}
    </span>
    <div class="h-12 w-px bg-[#FFF9F6]/30">
      <div class="h-4 w-px animate-bounce bg-[#FFF9F6]"></div>
    </div>
  </div>
</section>
