---
import { Phone, MapPin } from "@lucide/astro";
import { loadTranslations } from "@/lib/i18n";

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);

interface Props {
  phone: string;
  email: string;
  formattedLocation: string;
}

const { phone, email, formattedLocation } = Astro.props;
---

<div class="space-y-8">
  <!-- Ubicación -->
  <div class="bg-white rounded-2xl p-8 shadow-[0_10px_40px_rgba(0,0,0,0.08)] hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)] transition">
    <div class="w-12 h-12 bg-linear-to-br from-[#FEEBDD] to-[#EAD3C2] rounded-xl flex items-center justify-center mb-5 shadow-md">
      <MapPin class="text-[#513A31]" />
    </div>
    <h3 class="text-xl font-semibold text-[#513A31] mb-2">{t?.contact?.info?.location_title}</h3>
    <p class="text-[#7D6A5D] leading-relaxed" set:html={formattedLocation} />
  </div>

  <!-- Teléfono -->
  <div class="bg-white rounded-2xl p-8 shadow-[0_10px_40px_rgba(0,0,0,0.08)] hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)] transition">
    <div class="w-12 h-12 bg-linear-to-br from-[#FEEBDD] to-[#EAD3C2] rounded-xl flex items-center justify-center mb-5 shadow-md">
      <Phone class="text-[#513A31]" />
    </div>
    <h3 class="text-xl font-semibold text-[#513A31] mb-2">{t?.contact?.info?.phone_title}</h3>
    <p class="text-[#7D6A5D]">{phone}</p>
    <p class="text-sm text-[#7D6A5D] mt-2">{t?.contact?.info?.phone_hours}</p>
  </div>

  <!-- Email -->
  <div class="bg-white rounded-2xl p-8 shadow-[0_10px_40px_rgba(0,0,0,0.08)] hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)] transition">
    <div class="w-12 h-12 bg-linear-to-br from-[#FEEBDD] to-[#EAD3C2] rounded-xl flex items-center justify-center mb-5 shadow-md">
      ✉️
    </div>
    <h3 class="text-xl font-semibold text-[#513A31] mb-2">{t?.contact?.info?.email_title}</h3>
    <p class="text-[#7D6A5D]">{email}</p>
  </div>
</div>
