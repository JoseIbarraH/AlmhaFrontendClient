---
import Combobox from "@/components/ui/Combobox.astro";
import { countryCodes } from "@/data/countries";

interface Props {
  procedures: { value: string; label: string }[];
  whatsappLink?: string;
  whatsappActive?: boolean;
  whatsappOpenNewTab?: boolean;
}

const {
  procedures,
  whatsappLink = "",
  whatsappActive = false,
  whatsappOpenNewTab = false,
} = Astro.props;
---

<div class="bg-white rounded-3xl p-12 shadow-2xl">
  <h2 class="text-3xl font-semibold text-[#513A31] mb-2">Envíanos un mensaje</h2>
  <p class="text-[#7D6A5D] mb-10">
    Nuestro equipo se pondrá en contacto contigo muy pronto
  </p>

  <!-- Divider -->
  <div class="flex items-center gap-4 mb-10">
    <div class="h-px flex-1 bg-[#D6C4B6]/60"></div>
    <span class="text-sm text-[#7D6A5D] uppercase tracking-widest">Contacto</span>
    <div class="h-px flex-1 bg-[#D6C4B6]/60"></div>
  </div>

  <form id="contactForm" class="space-y-8">
    <div class="grid md:grid-cols-2 gap-2">
      <div>
        <label class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide">
          Nombre *
        </label>
        <input
          type="text"
          name="name"
          placeholder="Tu nombre"
          class="w-full px-4 py-3.5 bg-[#FFF9F6] border border-[#D6C4B6]/70 rounded-xl focus:border-[#7D6A5D] focus:ring-2 focus:ring-[#FEEBDD]/60 outline-none transition"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide">
          Email *
        </label>
        <input
          type="email"
          name="email"
          placeholder="tu@email.com"
          class="w-full px-4 py-3.5 bg-[#FFF9F6] border border-[#D6C4B6]/70 rounded-xl focus:border-[#7D6A5D] focus:ring-2 focus:ring-[#FEEBDD]/60 outline-none transition"
        />
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-2">
      <div>
        <label class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide">
          Teléfono *
        </label>
        <div class="flex gap-3">
          <div class="w-1/3">
            <input
              type="text"
              name="countryCode"
              id="countryCodeInput"
              list="countryCodes"
              placeholder="+57"
              value="+57"
              pattern="\+?[0-9]*"
              title="Solo se permiten números y el signo +"
              class="w-full px-4 py-3.5 bg-[#FFF9F6] border border-[#D6C4B6]/70 rounded-xl focus:border-[#7D6A5D] focus:ring-2 focus:ring-[#FEEBDD]/60 outline-none transition"
            />
            <datalist id="countryCodes">
              {countryCodes.map((country) => (
                <option value={country.code}>{country.name}</option>
              ))}
            </datalist>
          </div>
          <input
            type="tel"
            name="phone"
            id="phoneInput"
            placeholder="300 123 4567"
            pattern="[0-9\s]*"
            title="Solo se permiten números"
            class="w-2/3 px-4 py-3.5 bg-[#FFF9F6] border border-[#D6C4B6]/70 rounded-xl focus:border-[#7D6A5D] focus:ring-2 focus:ring-[#FEEBDD]/60 outline-none transition"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide">
          Procedimiento/otros
        </label>
        <Combobox options={procedures} name="procedure" placeholder="Seleccionar procedimiento..." />
      </div>
    </div>

    <div>
      <label class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide">
        Mensaje *
      </label>
      <textarea
        rows="5"
        name="message"
        placeholder="Cuéntanos tus expectativas..."
        class="w-full px-4 py-3.5 bg-[#FFF9F6] border border-[#D6C4B6]/70 rounded-xl focus:border-[#7D6A5D] focus:ring-2 focus:ring-[#FEEBDD]/60 outline-none resize-none transition"
      ></textarea>
    </div>

    <div class="flex flex-col gap-4">
      <button
        type="submit"
        class="w-full px-8 py-4 bg-linear-to-r from-[#513A31] to-[#7D6A5D] text-[#FEEBDD] font-semibold tracking-wide rounded-xl hover:scale-[1.02] hover:shadow-2xl active:scale-[0.98] transition-all duration-300"
      >
        Enviar mensaje
      </button>

      {whatsappActive && whatsappLink && (
        <a
          href={whatsappLink}
          target={whatsappOpenNewTab ? "_blank" : "_self"}
          rel={whatsappOpenNewTab ? "noopener noreferrer" : undefined}
          class="w-full px-8 py-4 flex items-center justify-center gap-2 bg-[#25D366] text-white font-semibold tracking-wide rounded-xl hover:scale-[1.02] hover:shadow-2xl hover:bg-[#20bd5a] active:scale-[0.98] transition-all duration-300 shadow-md"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
          </svg>
          Contactar por WhatsApp
        </a>
      )}
    </div>
  </form>
</div>
