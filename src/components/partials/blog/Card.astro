---
import placeholder from "@/assets/images/placeholder/placeholder.png";
import Icon from "@/components/ui/Icon.astro";
import { formatDate, getRelativeTime } from "@/lib/date";
import { loadTranslations } from "@/lib/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

const { image, category, writer, date, title, excerpts, slug } = Astro.props;

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);
---

<article
  class="bg-[#FFF9F6] rounded-2xl overflow-hidden hover-lift blog-card shadow-xl shadow-[#513A31]/10 transition-all duration-300 hover:shadow-2xl hover:shadow-[#513A31]/20 group"
>
  <figure class="relative overflow-hidden">
    <img
      src={image || placeholder.src}
      alt="Abdominoplastia"
      class="w-full h-64 object-cover transition-transform duration-500 group-hover:scale-110"
    />
    <!-- Overlay gradient -->
    <div
      class="absolute inset-0 bg-linear-to-t from-[#513A31]/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    >
    </div>

    <!-- Badge de categoría -->
    <span
      class="absolute top-4 left-4 bg-[#513A31]/90 backdrop-blur-sm text-[#FEEBDD] px-4 py-1.5 rounded-full text-sm font-medium shadow-lg"
    >
      {category}
    </span>

    <!-- Indicador de hover -->
    <div
      class="absolute bottom-4 right-4 w-10 h-10 bg-[#FEEBDD] rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0 transition-all duration-300"
    >
      <Icon name="arrow-right" />
    </div>

    <div class="p-6 bg-[#FFF9F6] relative">
      <!-- Decorative line -->
      <div
        class="absolute top-0 left-6 right-6 h-0.5 bg-linear-to-r from-transparent via-[#FEEBDD] to-transparent"
      >
      </div>

      <!-- Meta info -->
      <div
        class="flex items-center flex-wrap gap-x-3 gap-y-1 mb-4 text-xs text-[#7D6A5D]"
      >
        <span class="flex items-center gap-1.5 font-medium">
          <Icon name="user" size={14} />
          {writer || "Dr. Especialista"}
        </span>
        <span class="text-[#D6C4B6]">•</span>
        <span class="flex items-center gap-1.5">
          <Icon name="calendar" size={14} />
          {formatDate(date, currentLang)}
        </span>
        <span class="text-[#D6C4B6]">•</span>
        <span class="flex items-center gap-1.5">
          <Icon name="clock" size={14} />
          {getRelativeTime(date, t.helpers.date)}
        </span>
      </div>

      <!-- Title -->
      <header class="mb-4">
        <h3>
          <a
            href={getRelativeLocaleUrl(currentLang, `blog/${slug}`)}
            class="text-xl font-serif font-bold cursor-pointer text-[#513A31] leading-tight hover:text-[#7D6A5D] transition-colors duration-300 line-clamp-2"
          >
            {title}
          </a>
        </h3>
      </header>

      <!-- Description -->
      <p class="text-[#7D6A5D] leading-relaxed mb-6 line-clamp-3">
        {excerpts}
      </p>

      <!-- Divider -->
      <div
        class="h-px bg-linear-to-r from-transparent via-[#D6C4B6]/30 to-transparent mb-6"
      >
      </div>

      <!-- Footer -->
      <footer class="flex items-center justify-between">
        <a
          href={getRelativeLocaleUrl(currentLang, `blog/${slug}`)}
          class="inline-flex items-center gap-2 text-[#513A31] font-semibold hover:text-[#7D6A5D] transition-all duration-300 group/btn"
        >
          <span class="relative">
            {t.blog.list.card.read_more}
            <span
              class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#FEEBDD] group-hover/btn:w-full transition-all duration-300"
            ></span>
          </span>
          <Icon
            name="Arrow-right"
            size={20}
            class="transform group-hover/btn:translate-x-1 transition-transform duration-300"
          />
        </a>

        <!-- Reading time -->
        <span class="flex items-center gap-1.5 text-xs text-[#D6C4B6]">
          <Icon name="book-open" size={16} />
          {t.blog.list.card.read_time}
        </span>
      </footer>
    </div>
  </figure>

  <style>
    .hover-lift {
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
    }

    .hover-lift:hover {
      transform: translateY(-8px);
    }

    /* Line clamp utilities */
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .line-clamp-3 {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Smooth image zoom */
    .blog-card figure {
      position: relative;
      isolation: isolate;
    }
  </style>
</article>
