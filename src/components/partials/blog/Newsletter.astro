---
import { loadTranslations } from "@/lib/i18n";
import Icon from "@/components/ui/Icon.astro";

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);
const apiUrl = import.meta.env.PUBLIC_API_URL ?? process.env.PUBLIC_API_URL;
---

<div
  class="bg-linear-to-br from-[#513A31] to-[#7D6A5D] rounded-2xl p-6 shadow-xl relative overflow-hidden"
>
  <!-- Decoración -->
  <div
    class="absolute top-0 right-0 w-32 h-32 bg-[#FEEBDD]/10 rounded-full blur-3xl"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-24 h-24 bg-[#FEEBDD]/5 rounded-full blur-2xl"
  >
  </div>

  <div class="relative z-10">
    <div
      class="w-12 h-12 bg-[#FEEBDD] rounded-xl flex items-center justify-center mb-4"
    >
      <Icon name="mail" class="w-6 h-6 text-[#513A31]" />
    </div>

    <h3 class="text-xl font-bold text-[#FEEBDD] mb-2">
      {t.blog.newsletter.title}
    </h3>
    <p class="text-[#D6C4B6] text-sm mb-4">
      {t.blog.newsletter.description}
    </p>

    <form id="newsletter-form" class="space-y-3" data-api-url={apiUrl}>
      <input
        id="newsletter-email"
        type="email"
        placeholder={t.blog.newsletter.placeholder}
        required
        class="w-full px-4 py-3 rounded-lg bg-white/10 backdrop-blur-sm border border-[#FEEBDD]/30 text-[#FFF9F6] placeholder-[#D6C4B6] focus:outline-none focus:border-[#FEEBDD] transition-colors"
      />
      <button
        type="submit"
        class="w-full px-4 py-3 bg-[#FEEBDD] text-[#513A31] font-semibold rounded-lg hover:bg-[#FFF9F6] transition-colors flex items-center justify-center gap-2"
      >
        <span id="newsletter-button-text">{t.blog.newsletter.button}</span>
        <Icon name="arrow-right" class="w-4 h-4" />
      </button>
      <p id="newsletter-message" class="text-xs text-center hidden"></p>
    </form>
  </div>
</div>

<script>
  import { createApi } from "@/lib/api";

  const form = document.getElementById("newsletter-form") as HTMLFormElement;
  const emailInput = document.getElementById(
    "newsletter-email",
  ) as HTMLInputElement;
  const message = document.getElementById(
    "newsletter-message",
  ) as HTMLParagraphElement;
  const buttonText = document.getElementById(
    "newsletter-button-text",
  ) as HTMLSpanElement;

  if (form) {
    const lang = document.documentElement.lang || "es";
    const apiUrl = form.dataset.apiUrl;
    const api = createApi(lang, apiUrl);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = emailInput.value;

      const originalText = buttonText.textContent;
      buttonText.textContent = "Enviando...";
      message.classList.add("hidden");

      try {
        await api.get("/sanctum/csrf-cookie");

        // Manually extract CSRF token
        const xsrfToken = document.cookie
          .split("; ")
          .find((row) => row.startsWith("XSRF-TOKEN="))
          ?.split("=")[1];

        const headers = xsrfToken
          ? { "X-XSRF-TOKEN": decodeURIComponent(xsrfToken) }
          : {};

        const response = await api.post(
          "/api/client/subscribe",
          { email },
          { headers },
        );

        if (response.status === 200) {
          // Axios data is in response.data
          const data = response.data;
          message.textContent = data.message || "¡Gracias por suscribirte!";
          message.classList.remove("text-red-400", "hidden");
          message.classList.add("text-green-400");
          form.reset();
        } else {
          throw new Error("Ocurrió un error");
        }
      } catch (error) {
        console.error(error);
        const axiosErr = error as {
          response?: { data?: { message?: string } };
          message?: string;
        };
        const errorMessage =
          axiosErr.response?.data?.message ||
          axiosErr.message ||
          "Error al suscribirse";

        message.textContent = errorMessage;
        message.classList.remove("text-green-400", "hidden");
        message.classList.add("text-red-400");
      } finally {
        buttonText.textContent = originalText;
        setTimeout(() => {
          message.classList.add("hidden");
        }, 5000);
      }
    });
  }
</script>
