---
import { getRelativeLocaleUrl } from "astro:i18n";

const currentLang = Astro.currentLocale || "es";

const { title, category, category_code } = Astro.props;

---

<nav class="mb-8">
  <ol class="flex items-center gap-2 text-sm text-[#7D6A5D]">
    <li>
      <a href={getRelativeLocaleUrl(currentLang, '/')} class="hover:text-[#513A31] transition-colors">Inicio</a>
    </li>
    <li><span class="text-[#D6C4B6]">/</span></li>
    <li><a href={getRelativeLocaleUrl(currentLang, '/blog')} class="hover:text-[#513A31] transition-colors">Blog</a></li>
    <li><span class="text-[#D6C4B6]">/</span></li>
    <li><a href={getRelativeLocaleUrl(currentLang, `/blog?category=${category_code}&page=1`)} class="hover:text-[#513A31] transition-colors">{category}</a></li>
    <li><span class="text-[#D6C4B6]">/</span></li>
    <li class="text-[#513A31] font-medium">{title}</li>
  </ol>
</nav>
