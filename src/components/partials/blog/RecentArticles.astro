---
import Icon from "@/components/ui/Icon.astro";
import { getRelativeTime } from "@/lib/date";
import type { Data } from "@/types/blog";
import type { Translations } from "@/types/i18n";

interface Props {
  blogs: Data[];
  lang: string;
  t: Translations;
}

const { blogs, lang, t } = Astro.props;
---

<div
  class="bg-white rounded-2xl p-6 shadow-lg shadow-[#513A31]/5 border border-[#D6C4B6]/20"
>
  <h3 class="text-xl font-bold text-[#513A31] mb-4 flex items-center gap-2">
    <Icon name="clock" class="w-5 h-5 text-[#FEEBDD]" />
    {t.blog.recent_articles.title}
  </h3>
  <ul class="space-y-4">
    {
      blogs.map((item) => (
        <li class="group">
          <a
            href={`/${lang}/blog/${item.slug}`}
            class="flex gap-3 hover:bg-[#FEEBDD]/10 p-2 rounded-lg transition-colors"
          >
            <img
              src={item.image}
              alt="Artículo"
              class="w-16 h-16 object-cover rounded-lg"
            />
            <div class="flex-1">
              <h4 class="text-sm font-semibold text-[#513A31] group-hover:text-[#7D6A5D] line-clamp-2 transition-colors">
                {item.title}
              </h4>
              <span class="text-xs text-[#D6C4B6]">
                {getRelativeTime(item.created_at, t.helpers.date)}
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
