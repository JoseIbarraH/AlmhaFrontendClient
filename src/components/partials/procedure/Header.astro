---
import { loadTranslations } from "@/lib/i18n";

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);

const { image = "", title = "", subtitle = "", category = "" } = Astro.props;
---

<div class="relative w-full h-[60vh] lg:h-[70vh] overflow-hidden">
  <img src={image} alt={title} class="w-full h-full object-cover" />

  <!-- Overlay con gradiente -->
  <div
    class="absolute inset-0 bg-linear-to-b from-[#513A31]/60 via-[#513A31]/40 to-transparent"
  >
  </div>

  <!-- Contenido del Hero -->
  <div class="absolute inset-0 flex items-center justify-center text-center">
    <div class="max-w-4xl px-6">
      <span
        class="inline-block px-4 py-2 bg-[#FEEBDD]/90 backdrop-blur-sm text-[#513A31] rounded-full text-sm font-semibold mb-6 shadow-sm"
      >
        {category}
      </span>
      <div class="text-center text-[#FFF9F6]">
        <h1
          class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight mb-6 drop-shadow-lg"
        >
          {title}
        </h1>
        <p
          class="text-xl md:text-3xl font-light text-[#FEEBDD] max-w-2xl mx-auto leading-relaxed drop-shadow-md"
        >
          {subtitle}
        </p>
      </div>
    </div>
  </div>
</div>
