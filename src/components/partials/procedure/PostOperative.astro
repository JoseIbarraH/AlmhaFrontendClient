---
import type { Recommendation } from "@/types/procedure";
import { Check, X } from "@lucide/astro";

interface Props {
  doList: Recommendation[];
  dontList: Recommendation[];
}

const { doList, dontList } = Astro.props;
---

<section class="bg-[#FEEBDD] py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <h2
      class="text-4xl md:text-5xl font-light mb-12 text-center text-[#513A31]"
    >
      Cuidados Postoperatorios
    </h2>

    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <div class="bg-[#FFF9F6] rounded-lg p-8 shadow-lg">
        <h3
          class="text-2xl font-medium mb-6 text-[#513A31] flex items-center gap-3"
        >
          <span class="text-3xl">✓</span>
          Lo que SÍ debes hacer
        </h3>
        <ul class="space-y-4 text-[#7D6A5D]">
          {
            doList
              .sort((a, b) => a.order - b.order)
              .map((item) => (
                <li class="flex gap-3">
                  <span class="text-[#513A31] mt-1">•</span>
                  <span>{item.content}</span>
                </li>
              ))
          }
        </ul>
      </div>

      <div class="bg-[#FFF9F6] rounded-lg p-8 shadow-lg">
        <h3
          class="text-2xl font-medium mb-6 text-[#513A31] flex items-center gap-3"
        >
          <span class="text-3xl">✗</span>
          Lo que NO debes hacer
        </h3>
        <ul class="space-y-4 text-[#7D6A5D]">
          {
            dontList
              .sort((a, b) => a.order - b.order)
              .map((item) => (
                <li class="flex gap-3">
                  <span class="text-[#513A31] mt-1">•</span>
                  <span>{item.content}</span>
                </li>
              ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

