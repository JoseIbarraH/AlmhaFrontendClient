---
import { loadTranslations } from "@/lib/i18n";

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);

interface Props {
  image?: string;
}

const { image = "" } = Astro.props;
---

<div>
  <img src={image} alt="Rinoplastia" class="w-full h-full object-cover" />

  <!-- Overlay con gradiente -->
  <div
    class="absolute inset-0 bg-linear-to-b from-[#513A31]/60 via-[#513A31]/40 to-transparent"
  >
  </div>

  <!-- Contenido del Hero -->
  <div class="absolute inset-0 flex items-center justify-center text-center">
    <div class="max-w-3xl px-6">
      <span
        class="inline-block px-4 py-2 bg-[#FEEBDD]/90 backdrop-blur-sm text-[#513A31] rounded-full text-sm font-semibold mb-4"
      >
        {t.procedure.header.tag}
      </span>
      <div class="text-center text-[#FFF9F6] px-4">
        <h1 class="text-5xl md:text-7xl font-[#FFF9F6] tracking-wide mb-4">
          {t.procedure.header.title}
        </h1>
        <p class="text-xl md:text-2xl font-[#FFF9F6] text-[#FEEBDD]">
          {t.procedure.header.subtitle}
        </p>
      </div>
    </div>
  </div>
</div>
