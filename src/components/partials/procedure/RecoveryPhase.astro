---
import type { ProcedureSection, RecoveryPhase } from "@/types/procedure";

interface Props {
  phases: RecoveryPhase[];
}

import { loadTranslations } from "@/lib/i18n";

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);

const { phases } = Astro.props;
---

<section class="bg-[#D6C4B6] py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <h2
      class="text-4xl md:text-5xl font-light mb-16 text-center text-[#513A31]"
    >
      {t.procedure.recovery_phase.title}
    </h2>

    <div class="space-y-8">
      {
        phases
          .sort((a, b) => a.order - b.order)
          .map((phase) => (
            <div class="flex gap-6 items-start">
              <div class="shrink-0 w-32 text-right">
                <span class="text-2xl font-light text-[#513A31]">
                  {phase.period}
                </span>
              </div>
              <div class="shrink-0 w-4 h-4 bg-[#513A31] rounded-full mt-2" />
              <div class="flex-1 bg-[#FFF9F6] rounded-lg p-6 shadow-lg">
                <h3 class="text-xl font-medium mb-2 text-[#513A31]">
                  {phase.title}
                </h3>
                <p class="text-[#7D6A5D] leading-relaxed">
                  {phase.description}
                </p>
              </div>
            </div>
          ))
      }
    </div>
  </div>
</section>

