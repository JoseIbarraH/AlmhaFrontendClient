---
import type { ProcedureSection } from "@/types/procedure";
import placeholder from "@/assets/images/placeholder/placeholder.png";

interface Props {
  data: ProcedureSection;
}

const { data } = Astro.props;
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Imagen -->
      <div class="order-2 lg:order-1 relative group">
        <div
          class="absolute -inset-4 bg-[#FEEBDD] rounded-4xl rotate-3 transition-transform duration-500 group-hover:rotate-6"
        >
        </div>
        <img
          src={data.image || placeholder.src}
          alt={data.title}
          class="relative w-full h-[500px] object-cover rounded-3xl shadow-xl transition-transform duration-500 group-hover:-translate-y-2"
        />
      </div>

      <!-- Contenido de Texto -->
      <div class="space-y-8 order-1 lg:order-2">
        <h2 class="text-4xl md:text-5xl font-[#FFF9F6] mb-6 text-[#513A31]">
          {data.title}
        </h2>

        <div class="space-y-6">
          <div class="text-lg leading-relaxed text-[#7D6A5D] mb-6">
            <p>{data.contentOne}</p>
          </div>
          <div class="text-lg leading-relaxed text-[#7D6A5D]">
            <p>{data.contentTwo}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

