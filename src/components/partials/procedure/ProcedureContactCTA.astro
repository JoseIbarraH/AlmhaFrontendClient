---
import { loadTranslations } from "@/lib/i18n";

interface Props {
  whatsapp_number?: string | null;
  whatsapp_active?: boolean;
  whatsapp_message?: string | null;
  whatsapp_open_new_tab?: boolean;
  procedure_title?: string;
}

const {
  whatsapp_number,
  whatsapp_active,
  whatsapp_message,
  whatsapp_open_new_tab,
  procedure_title
} = Astro.props;

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);

let whatsappLink = "";
if (whatsapp_number) {
  const cleanNumber = String(whatsapp_number).replace(/\D/g, "");
  let finalMessage = String(whatsapp_message || "");
  if (procedure_title) {
    finalMessage = finalMessage.replace(/\{\{\s*procedure\s*\}\}/g, procedure_title);
  }
  const query = finalMessage ? `?text=${encodeURIComponent(finalMessage)}` : "";
  whatsappLink = `https://wa.me/${cleanNumber}${query}`;
}
---

<section class="w-full bg-[#FFF9F6] py-20 px-6 sm:px-12 lg:px-24 flex items-center justify-center">
  <div class="max-w-4xl w-full bg-linear-to-br from-[#513A31] to-[#7D6A5D] rounded-[2rem] p-10 md:p-16 text-center shadow-2xl relative overflow-hidden">
    <!-- Overlay/Decorative glow -->
    <div class="absolute -top-20 -left-20 w-64 h-64 bg-[#FEEBDD]/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-20 -right-20 w-64 h-64 bg-[#FEEBDD]/10 rounded-full blur-3xl"></div>
    
    <div class="relative z-10 flex flex-col items-center gap-6">
      <!-- Decorative Icon/Element -->
      <div class="w-16 h-16 bg-[#FEEBDD] rounded-full flex items-center justify-center shadow-lg mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#513A31" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
      </div>

      <h2 class="font-advent text-3xl md:text-5xl font-semibold text-[#FFF9F6] tracking-wide">
        ¿Te interesa este procedimiento?
      </h2>
      
      <p class="text-[#FEEBDD]/90 text-lg md:text-xl max-w-2xl font-light leading-relaxed">
        Agenda tu consulta hoy mismo para recibir atención personalizada y despejar todas tus dudas.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 w-full justify-center mt-4">
        <a
          href={`/${currentLang}/contact`}
          class="px-10 py-4 bg-[#FEEBDD] text-[#513A31] font-semibold tracking-wide rounded-xl
                 hover:scale-[1.05] hover:shadow-xl hover:bg-white active:scale-[0.98]
                 transition-all duration-300 inline-flex items-center justify-center gap-3 w-full sm:w-auto"
        >
          <span>Ir a Contacto</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>

        {whatsapp_active && whatsapp_number && (
          <a
            href={whatsappLink}
            target={whatsapp_open_new_tab ? "_blank" : "_self"}
            rel={whatsapp_open_new_tab ? "noopener noreferrer" : undefined}
            class="px-8 py-4 bg-[#25D366] text-white font-semibold tracking-wide rounded-xl
                   hover:scale-[1.05] hover:shadow-xl hover:bg-[#20bd5a] active:scale-[0.98]
                   transition-all duration-300 inline-flex items-center justify-center gap-2 w-full sm:w-auto shadow-md"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
            </svg>
            Contactar por WhatsApp
          </a>
        )}
      </div>
    </div>
  </div>
</section>
