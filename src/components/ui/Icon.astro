---
import * as icons from "lucide-static";

interface Props {
  name: string;
  class?: string;
  size?: number;
  color?: string;
}

const { name, class: className = "", size = 24, color } = Astro.props;

const iconName = name
  .split("-")
  .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
  .join("");

let svg = icons[iconName as keyof typeof icons];

if (!svg) {
  console.warn(`Icon "${name}" (${iconName}) not found`);
} else {
  // Modificar el SVG para aplicar width, height y color directamente
  svg = svg
    .replace(/width="\d+"/, `width="${size}"`)
    .replace(/height="\d+"/, `height="${size}"`)
    .replace(/stroke="[^"]*"/, color ? `stroke="${color}"` : 'stroke="currentColor"');
}
---

{
  svg ? (
    <span
      class={`icon-wrapper inline-flex items-center justify-center ${className}`}
      set:html={svg}
    />
  ) : (
    <div
      class={`inline-block bg-red-500 ${className}`}
      style={`width: ${size}px; height: ${size}px;`}
      title={`Icon ${name} not found`}
    />
  )
}

<style>
  .icon-wrapper {
    color: currentColor;
  }

  .icon-wrapper svg {
    display: block;
    stroke: currentColor;
    fill: none;
  }
</style>