---
import { getRelativeLocaleUrl } from "astro:i18n";
import logoImage from "@/assets/images/Imagotipo_horizontal_beige.png";
import logo from "@/assets/images/logo.png";

interface Props {
  class?: string;
  size?: "sm" | "md" | "lg" | "xl" | "xl2" | string;
  text?: boolean;
  textSize?: "sm" | "md" | "lg" | "xl" | "xl2" | string;
  phone?: boolean;
}

const currentLang = Astro.currentLocale || "es";
const {
  class: className = "",
  size = "md",
  text = false,
  textSize = "md",
  phone = false,
} = Astro.props;

const sizeClasses = {
  sm: "h-8 w-auto",
  md: "h-10 w-auto",
  lg: "h-16 w-auto",
  xl: "h-32 w-auto",
  xl2: "h-64 w-auto",
};

const computedSize =
  sizeClasses[size as keyof typeof sizeClasses] || size || "h-10 w-auto";
---

<div class="shrink-0 flex flex-col w-full">
  <a
    href={getRelativeLocaleUrl(currentLang, "/")}
    class={`inline-flex items-center transition-opacity hover:opacity-80 ${className}`}
    aria-label="Ir al inicio"
  >
    {
      phone ? (
        <img
          src={logo.src}
          alt="Logo"
          class={computedSize + " object-contain w-full"}
          loading="eager"
        />
      ) : (
        <img
          src={logoImage.src}
          alt="Logo"
          class={computedSize + " object-contain w-full"}
          loading="eager"
        />
      )
    }
  </a>
</div>
