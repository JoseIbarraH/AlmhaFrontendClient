---
import Procedures from "@/components/shared/Procedures.astro";
import LanguageSwitcher from "../ui/LanguageSwitcher.astro";
import ContacButton from "../ui/ContacButton.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import ContactData from "../ui/ContactData.astro";
import CarouselComponent from "../shared/Carousel.astro";
import type { Carousel, Procedure } from "@/types/navbar";
import { loadTranslations } from "@/lib/i18n";
import Logo from "../ui/Logo.astro";
import Icon from "../ui/Icon.astro";

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);

const menuItems = [
  { href: "/", label: t.navbar.links.home, drop: false },
  { href: "/service", label: t.navbar.links.service, drop: true },
  { href: "/about", label: t.navbar.links.about, drop: false },
  { href: "/contact", label: t.navbar.links.contact, drop: false },
  { href: "/blog", label: t.navbar.links.blog, drop: false },
];

const { api } = Astro.locals;
let images: Carousel[] = [];
let topProcedure: Procedure[] = [];
let procedures: Record<string, Procedure[]> = {};

try {
  const { data } = await api.get("api/client/navbar-data");
  const response = data.data;
  images = response.carousel ?? [];
  topProcedure = response.topProcedure ?? [];
  procedures = response.procedures ?? {};
  console.log(procedures);
} catch (error) {
  console.error("Error fetching navbar data:", error);
}
---

<div class="relative">
  <!-- Navbar Principal -->
  <nav
    id="main-navbar"
    class="w-full fixed top-0 z-50 transition-transform duration-300 ease-in-out"
  >
    <!-- Top Header (Logo/Hamburger) -->
    <div id="navbar-header" class="w-full patron relative bg-[#513A31] z-50">
      <div
        class="container mx-auto relative flex items-center justify-between py-4 px-6 lg:px-8"
      >
        <!-- Left: Mobile hamburger -->
        <button
          id="hamburger-btn"
          class="hamburger-btn flex items-center transition-colors rounded-lg px-2 py-1 -ml-2 z-50 hover:bg-[#FEEBDD]/10"
          type="button"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <span class="hamburger hamburger--spin scale-75" aria-hidden="true">
            <span class="hamburger-box">
              <span class="hamburger-inner"></span>
            </span>
          </span>
          <span class="text-[#FFF9F6] text-sm font-medium">{t.navbar.menu}</span
          >
        </button>

        <!-- Center: LOGO SIEMPRE CENTRADO -->
        <div
          class="absolute left-1/2 -translate-x-1/2 max-w-[200px] md:max-w-[250px] z-40"
        >
          <div class="overflow-hidden">
            <Logo
              class="text-[#FEEBDD] hover:text-[#FFF9F6] transition-colors w-full h-auto max-h-10 object-contain"
            />
          </div>
        </div>

        <!-- Right: Desktop items -->
        <div class="md:flex items-center gap-6 ml-auto z-40">
          <LanguageSwitcher />
          <div class="hidden md:flex items-center gap-6 ml-auto z-40">
            <ContacButton />
          </div>
        </div>
      </div>
      <div class="h-px bg-[#7D6A5D]"></div>
    </div>

    <!-- Collapsible Procedures Bar -->
    <div
      id="navbar-procedures"
      class="bg-[#513A31]/95 backdrop-blur-md transition-all duration-500 ease-in-out opacity-100 origin-top relative z-40"
    >
      <div class="container mx-auto px-4 md:px-6 lg:px-8">
        <div
          class="flex justify-start md:justify-center gap-4 md:gap-8 lg:gap-12 text-sm relative overflow-x-auto md:overflow-visible pb-2 md:pb-0 scrollbar-hide snap-x snap-mandatory"
        >
          {
            Object.entries(procedures).map(([category, items]) => (
              <div class="relative group shrink-0 snap-center procedure-category">
                <button
                  class="procedure-btn flex items-center gap-1 text-[#FEEBDD] uppercase tracking-widest text-[10px] md:text-xs py-3 md:py-2 px-2 md:px-0 hover:text-white transition-colors whitespace-nowrap"
                  data-category-btn
                >
                  {category}
                  <Icon
                    name="chevron-down"
                    class="w-3 h-3 transition-transform duration-300 pointer-events-none"
                  />
                </button>

                {/* Dropdown para móvil - Aparece debajo */}
                <div class="procedure-dropdown md:hidden fixed left-0 right-0 top-full mt-0 bg-[#513A31]/98 backdrop-blur-md border-t border-[#FEEBDD]/20 p-2 opacity-0 invisible transition-all duration-300 shadow-xl flex flex-col gap-2 z-50 max-h-[70vh] overflow-y-auto">
                  {items.map((item, index) => (
                    <a
                      href={getRelativeLocaleUrl(
                        currentLang,
                        `procedure/${item.slug}`,
                      )}
                      class="menu-link-wrapper dropdown-item group/item flex items-center gap-3 py-3 px-3 rounded-lg
                    hover:bg-[#FEEBDD]/10 active:bg-[#FEEBDD]/20 transition-all duration-300
                    opacity-0"
                      style={`transition-delay: ${index * 50}ms`}
                    >
                      <div
                        class="shrink-0 w-8 h-8 flex items-center justify-center
                      bg-[#FEEBDD]/20 group-hover/item:bg-[#FEEBDD]/30
                      rounded-md transition-all duration-300"
                      >
                        <Icon
                          name="arrow-right"
                          color="#FEEBDD"
                          class="w-3 h-3 text-[#FEEBDD] transition-transform duration-300"
                        />
                      </div>

                      <span class="text-[#FFF9F6] text-sm font-bold group-hover/item:text-[#FEEBDD] transition-colors duration-300 flex-1">
                        {item.title}
                      </span>

                      <div class="w-0 h-0.5 bg-[#FEEBDD] group-hover/item:w-4 transition-all duration-500 rounded-full" />
                    </a>
                  ))}
                </div>

                {/* Dropdown para desktop - Aparece centrado */}
                <div class="procedure-dropdown hidden md:block absolute left-1/2 -translate-x-1/2 w-72 bg-[#513A31]/95 backdrop-blur-md border border-[#FEEBDD]/20 rounded-xl p-2 opacity-0 invisible transition-all duration-300 transform translate-y-2 shadow-xl z-50">
                  {items.map((item, index) => (
                    <a
                      href={getRelativeLocaleUrl(
                        currentLang,
                        `procedure/${item.slug}`,
                      )}
                      class="menu-link-wrapper dropdown-item group/item flex items-center gap-3 py-2 px-3 rounded-lg
                          hover:bg-[#FEEBDD]/10 transition-all duration-300 opacity-0 translate-y-0 md:translate-y-0"
                      style={`transition-delay: ${index * 50}ms`}
                    >
                      <div
                        class="shrink-0 w-8 h-8 flex items-center justify-center
                      bg-[#FEEBDD]/20 group-hover/item:bg-[#FEEBDD]/30
                      rounded-md transition-all duration-300
                      group-hover/item:translate-x-1"
                      >
                        <Icon
                          name="arrow-right"
                          color="#FEEBDD"
                          class="w-3 h-3 text-[#FEEBDD] transition-transform duration-300 group-hover/item:scale-110"
                        />
                      </div>

                      <span class="text-[#FFF9F6] text-sm font-bold group-hover/item:text-[#FEEBDD] transition-colors duration-300 group-hover/item:translate-x-1">
                        {item.title}
                      </span>

                      <div class="ml-auto w-0 h-0.5 bg-[#FEEBDD] group-hover/item:w-4 transition-all duration-500 rounded-full" />
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </nav>

  <!-- Menú Fullscreen -->
  <div
    id="fullscreen-menu"
    class="fixed left-0 right-0 bg-linear-to-br from-[#513A31]/98 to-[#7D6A5D]/98 backdrop-blur-md z-30
           opacity-0 invisible transition-all duration-500 ease-out overflow-hidden"
    style="top: var(--header-height, 80px); bottom: 0;"
  >
    <!-- Grid responsivo -->
    <div class="grid grid-cols-1 md:grid-cols-4 h-full w-full">
      <!-- Columna 1: Carousel - OCULTA EN MÓVIL -->
      <div class="h-full w-full overflow-hidden hidden md:block relative">
        <div
          class="absolute inset-0 bg-linear-to-r from-transparent to-[#513A31]/30 z-10"
        >
        </div>
        <CarouselComponent buttonDown={true} slides={images} />
      </div>

      <!-- Columna 2: Links del menú - VISIBLE EN MÓVIL -->
      <div
        class="h-full flex flex-col items-start justify-center gap-4 md:gap-6 px-6 md:px-10 relative mt-10 md:mt-0"
      >
        <div>
          <span
            class="text-[#FEEBDD] text-xs md:text-sm font-semibold tracking-widest uppercase"
          >
            {t.navbar.navigation.title}
          </span>
          <h2 class="text-xl md:text-2xl font-bold text-[#FFF9F6] mt-2 md:mt-4">
            {t.navbar.navigation.subtitle}
          </h2>
        </div>

        {
          menuItems.map((item, index) => (
            <a
              href={getRelativeLocaleUrl(currentLang, item.href)}
              class="menu-link-wrapper group flex items-center gap-3 py-2 px-4 -mx-4 rounded-lg
                    hover:bg-[#FEEBDD]/10 transition-all duration-300
                    opacity-0 translate-y-8"
              style={`transition-delay: ${index * 100}ms`}
            >
              <div
                class="shrink-0 w-6 h-6 flex items-center justify-center
                          bg-[#FEEBDD]/20 group-hover:bg-[#FEEBDD]/30
                          rounded-md transition-all duration-300
                          group-hover:translate-x-1"
              >
                <Icon
                  name="arrow-right"
                  color="#FEEBDD"
                  class="w-4 h-4 text-[#FEEBDD] transition-transform duration-300 group-hover:scale-110"
                />
              </div>

              <span
                tabindex="0"
                role="button"
                class="text-[#FFF9F6] text-xl md:text-2xl font-bold group-hover:text-[#FEEBDD] transition-colors duration-300 group-hover:translate-x-1"
              >
                {item.label}
              </span>

              <div class="ml-auto w-0 h-0.5 bg-[#FEEBDD] group-hover:w-8 transition-all duration-500 rounded-full" />
            </a>
          ))
        }

        <div class="flex justify-center items-center w-full md:hidden mt-20">
          <ContacButton />
        </div>

        <!-- Separador derecho -->
        <div
          class="absolute right-0 top-0 bottom-0 w-px bg-linear-to-b from-transparent via-[#FEEBDD]/30 to-transparent"
        >
        </div>
      </div>

      <!-- Columna 3: Procedimientos - OCULTA EN MÓVIL -->
      <div
        class="h-full flex-col items-center justify-start px-4 py-6 relative overflow-hidden hidden md:flex bg-[#513A31]/20"
      >
        <!-- Contenedor con scroll interno -->
        <div
          class="w-full h-full overflow-y-auto scrollbar-custom flex flex-col gap-4 pr-2"
        >
          {
            topProcedure.map((item, __index) => (
              <Procedures
                image={item.image}
                title={item.title}
                slug={item.slug}
              />
            ))
          }
        </div>

        <!-- Separador vertical -->
        <div
          class="absolute right-0 top-0 bottom-0 w-px bg-linear-to-b from-transparent via-[#FEEBDD]/30 to-transparent"
        >
        </div>
      </div>

      <!-- Columna 4: Contacto - VISIBLE EN MÓVIL -->
      <div class="h-full relative overflow-hidden">
        <div
          class="h-full flex flex-col items-start justify-center gap-4 md:gap-6 px-6 md:px-10 relative"
        >
          <div class="text-[#FFF9F6] text-xl md:text-2xl font-bold">
            <div>
              <span
                class="text-[#FEEBDD] text-xs md:text-sm font-semibold tracking-widest uppercase"
              >
                {t.navbar.contact.title}
              </span>
              <h2
                class="text-xl md:text-2xl font-bold text-[#FFF9F6] mt-2 md:mt-4 mb-4 md:mb-6"
              >
                {t.navbar.contact.subtitle}
              </h2>

              <div class="space-y-4 md:space-y-6">
                <ContactData
                  icon="phone"
                  title={t.navbar.contact.phone}
                  value="+57 3131231233"
                />
                <ContactData
                  icon="mail"
                  title={t.navbar.contact.email}
                  value="info@esteticaelite.com"
                />
                <ContactData
                  icon="map-pin"
                  title={t.navbar.contact.location}
                  value="Cartagena"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Decoración -->
        <div
          class="absolute inset-0 pointer-events-none opacity-50 md:opacity-100"
        >
          <div
            class="absolute top-1/4 right-1/4 w-40 h-40 md:w-64 md:h-64 bg-[#FEEBDD]/10 rounded-full blur-3xl"
          >
          </div>
          <div
            class="absolute bottom-1/4 left-1/4 w-60 h-60 md:w-96 md:h-96 bg-[#FEEBDD]/5 rounded-full blur-3xl"
          >
          </div>
        </div>
        <div class="logo"></div>
      </div>
    </div>
  </div>
</div>

<script>
  function initMenu() {
    const navbar = document.getElementById("main-navbar");
    const navbarHeader = document.getElementById("navbar-header");
    const hamburgerBtn = document.getElementById("hamburger-btn");
    const hamburger = hamburgerBtn?.querySelector(".hamburger");
    const fullscreenMenu = document.getElementById("fullscreen-menu");
    const menuLinks = fullscreenMenu?.querySelectorAll(".menu-link");
    const navbarProcedure = document.getElementById("navbar-procedures");

    // Calcular altura del header principal (parte superior fija)
    function updateHeaderHeight() {
      if (navbarHeader && fullscreenMenu) {
        const headerHeight = navbarHeader.offsetHeight;
        fullscreenMenu.style.setProperty(
          "--header-height",
          `${headerHeight}px`,
        );
      }
    }

    // Inicializar altura
    updateHeaderHeight();

    let isOpen = false;

    function toggleMenu() {
      isOpen = !isOpen;

      // Toggle clases
      hamburger?.classList.toggle("is-active");
      fullscreenMenu?.classList.toggle("open");
      document.body.classList.toggle("menu-open");

      // Animar navbar procedures (slide up/fade out)
      navbarProcedure?.classList.toggle("collapsed");

      // Actualizar aria
      hamburgerBtn?.setAttribute("aria-expanded", String(isOpen));
    }

    // Click en el botón hamburger
    if (hamburgerBtn) {
      hamburgerBtn.addEventListener("click", (e) => {
        e.preventDefault();
        toggleMenu();
      });
    }

    // Cerrar al hacer click en un link
    menuLinks?.forEach((link) => {
      link.addEventListener("click", () => {
        if (isOpen) toggleMenu();
      });
    });

    // Cerrar con ESC
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        toggleMenu();
      }
    });

    // Recalcular altura al redimensionar
    window.addEventListener("resize", () => {
      updateHeaderHeight();
    });

    let lastScrollTop = 0;
    const scrollThreshold = 10;
    let ticking = false;

    function updateNavbarVisibility() {
      const scrollTop =
        window.pageYOffset || document.documentElement.scrollTop;

      if (isOpen) {
        ticking = false;
        return;
      }

      const scrollDifference = Math.abs(scrollTop - lastScrollTop);

      if (scrollDifference >= scrollThreshold) {
        if (scrollTop > lastScrollTop && scrollTop > 80) {
          navbar?.classList.add("-translate-y-full");
        } else if (scrollTop < lastScrollTop) {
          navbar?.classList.remove("-translate-y-full");
        }

        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
      }

      ticking = false;
    }

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateNavbarVisibility);
          ticking = true;
        }
      },
      { passive: true },
    );

    // Procedure Dropdowns - Click to Toggle Logic
    const procedureBtns = document.querySelectorAll(".procedure-btn");

    // Función para cerrar todos
    function closeAllDropdowns() {
      document.querySelectorAll(".procedure-category.active").forEach((cat) => {
        cat.classList.remove("active");
      });
    }

    procedureBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation(); // Evitar cerrar al hacer click en el propio botón
        const parent = btn.closest(".procedure-category");
        const isActive = parent?.classList.contains("active");

        // Cerrar todos antes de abrir el nuevo (comportamiento acordeón)
        closeAllDropdowns();

        if (!isActive && parent) {
          parent.classList.add("active");
        }
      });
    });

    // Cerrar al hacer click fuera
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest(".procedure-category")) {
        closeAllDropdowns();
      }
    });

    // Dropdown Logic (for menu items)
    const dropdownBtns = document.querySelectorAll(".dropdown-btn");
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMenu);
  } else {
    initMenu();
  }

  document.addEventListener("astro:page-load", initMenu);
</script>

<style is:global>
  /* Estilos del hamburger con nueva paleta */
  .hamburger-inner,
  .hamburger-inner::before,
  .hamburger-inner::after {
    background-color: #feebdd !important;
  }

  .hamburger-btn:hover .hamburger-inner,
  .hamburger-btn:hover .hamburger-inner::before,
  .hamburger-btn:hover .hamburger-inner::after {
    background-color: #fff9f6 !important;
  }

  /* Cuando el menú está abierto */
  #fullscreen-menu.open {
    opacity: 1;
    visibility: visible;
  }

  #fullscreen-menu.open .menu-link,
  #fullscreen-menu.open > div > div:nth-child(3) {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }

  /* Prevenir scroll cuando el menú está abierto */
  body.menu-open {
    overflow: hidden;
  }

  /* Responsive: En móvil mostrar solo 1 columna */
  @media (max-width: 768px) {
    #fullscreen-menu > div {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
    }

    #fullscreen-menu > div > div:first-child {
      display: none;
    }

    #fullscreen-menu > div > div:last-child {
      display: none;
    }
  }

  /* Efecto de entrada escalonada */
  #fullscreen-menu.open .menu-link-wrapper {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }

  /* Efecto de brillo en hover */
  .menu-link-wrapper::before {
    content: "";
    position: absolute;
    left: -4px;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 0;
    background: linear-gradient(to bottom, transparent, #feebdd, transparent);
    border-radius: 2px;
    transition: height 0.3s ease;
  }

  .menu-link-wrapper:hover::before {
    height: 60%;
  }

  /* Animación del icono */
  @keyframes icon-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .menu-link-wrapper:hover svg {
    animation: icon-pulse 1s ease-in-out infinite;
  }

  /* Scrollbar personalizado */
  .scrollbar-custom::-webkit-scrollbar {
    width: 6px;
  }

  .scrollbar-custom::-webkit-scrollbar-track {
    background: #7d6a5d;
    border-radius: 10px;
  }

  .scrollbar-custom::-webkit-scrollbar-thumb {
    background: #feebdd;
    border-radius: 10px;
  }

  .scrollbar-custom::-webkit-scrollbar-thumb:hover {
    background: #d6c4b6;
  }

  .logo {
    /* 1. Posicionamiento: Usamos 'absolute' para fijarlo a la esquina */
    position: absolute;

    /* 2. Dimensiones: Necesitas un tamaño para que la imagen se muestre */
    width: 100px;
    height: 100px;

    /* 3. Colocación en la esquina inferior derecha */
    /* Fija el elemento a 20px del borde inferior y 20px del borde derecho */
    bottom: 20px;
    right: 20px;

    /* 4. Imagen de fondo */
    background: url("/src/assets/images/logo.png");
    background-size: 100% 100%; /* El 100% hace que la imagen llene el espacio de 100x100px */
    background-repeat: no-repeat; /* Asegura que no se repita */
  }

  .patron::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    background-image:
      url("/src/assets/images/logo.png"), url("/src/assets/images/logo.png");

    background-size:
      40px 40px,
      40px 40px;

    background-position:
      0 0,
      20px 20px;

    background-repeat: repeat, repeat;
    background-origin: padding-box;

    opacity: 0.1;
    z-index: 1;
  }

  .patron > * {
    position: relative;
    z-index: 2;
    color: #ffffff;
  }

  #navbar-procedures.collapsed {
    max-height: 0;
    opacity: 0;
    transform: translateY(-100%);
    overflow: hidden;
  }
  /* Navbar Procedure Dropdown Animation */
  /* Navbar Procedure Dropdown Animation - Toggle Based */
  .procedure-category.active .procedure-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .procedure-category.active .procedure-btn svg {
    transform: rotate(180deg);
  }

  /* Staggered animation for items inside open dropdown */
  .procedure-category.active .dropdown-item {
    opacity: 1;
    transform: translateY(0);
  }
</style>
