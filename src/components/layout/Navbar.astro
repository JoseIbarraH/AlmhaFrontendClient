---
import type { Carousel, Procedure, Settings } from "@/types/navbar";
import LanguageSwitcher from "../ui/LanguageSwitcher.astro";
import ContacButton from "../ui/ContactButton.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { loadTranslations } from "@/lib/i18n";
import Logo from "../ui/Logo.astro";
import { ChevronDown, ChevronRight } from "@lucide/astro";

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);

const menuItems = [
  { href: "/", label: t.navbar.links.home, drop: false },
  { href: "/procedure", label: t.navbar.links.procedure, drop: true },
  { href: "/about", label: t.navbar.links.about, drop: false },
  { href: "/contact", label: t.navbar.links.contact, drop: false },
  { href: "/blog", label: t.navbar.links.blog, drop: false },
];

interface Props {
  procedures: Record<string, Procedure[]>;
  settings: Settings | null;
  procedureContext?: string;
  localizedPaths?: Record<string, string>;
}

const { procedures = {}, settings = null, procedureContext = "", localizedPaths } = Astro.props;
---

<div class="relative">
  <nav
    id="main-navbar"
    class="w-full fixed top-0 z-50 transition-transform duration-300 ease-in-out"
  >
    <div
      id="navbar-header"
      class="w-full patron relative bg-[#513A31] z-50 border-b border-[#7D6A5D] md:h-[150px]"
    >
      <div
        class="container mx-auto relative flex items-center justify-between px-4 h-full"
      >
        <div class="block md:hidden">
          <button
            id="hamburger-btn"
            class="hamburger-btn flex items-center transition-colors rounded-lg px-2 py-1 -ml-2 z-50 hover:bg-[#FEEBDD]/10"
            type="button"
            aria-label={t.common.menu.toggle_aria}
            aria-expanded="false"
          >
            <span class="hamburger hamburger--spin scale-75" aria-hidden="true">
              <span class="hamburger-box">
                <span class="hamburger-inner"></span>
              </span>
            </span>
          </button>
        </div>
        <div
          class="absolute left-1/2 -translate-x-1/2 max-w-[400px] md:max-w-[450px] z-40"
        >
          <div class="overflow-hidden w-full py-4">
            <div class="block lg:hidden w-full">
              <Logo
                phone={true}
                class="text-[#FEEBDD] hover:text-[#FFF9F6] transition-colors w-full h-auto object-contain"
                size="sm"
              />
            </div>
            <div class="hidden lg:block w-full">
              <Logo
                phone={false}
                class="text-[#FEEBDD] hover:text-[#FFF9F6] transition-colors w-full h-auto object-contain"
                size="lg"
              />
            </div>
          </div>
        </div>

        <div class="md:flex items-center gap-6 ml-auto z-40">
          <LanguageSwitcher localizedPaths={localizedPaths} />
          <div class="hidden md:flex items-center gap-6 ml-auto z-40">
            <ContacButton />
          </div>
        </div>
      </div>
    </div>
    <div class="bg-[#513A31] hidden md:block">
      <div
        class="h-full flex items-start justify-center gap-4 md:gap-6 px-6 md:px-10 relative"
      >
        {
          menuItems.map((item, index) =>
            item.drop ? (
              <div class="group relative inline-block">
                <a
                  href={getRelativeLocaleUrl(currentLang, item.href)}
                  class="flex items-center gap-2 py-2 px-2 hover:bg-[#FEEBDD]/10 transition-colors"
                >
                  <span class="text-[#FFF9F6] text-xl font-advent">
                    {item.label}
                  </span>

                  <div class="flex justify-center items-center transition-all duration-200 transform group-hover:rotate-180 text-[#FFF9F6] group-hover:text-[#FEEBDD]">
                    <ChevronDown size={20} />
                  </div>
                </a>

                <ul class="absolute hidden group-hover:block w-48 pt-2 z-10 divide-y divide-gray-300 dark:divide-gray-500">
                  {Object.entries(procedures).map(
                    ([categoryName, subItems]) => (
                      <li class="group/sub relative bg-[#513A31] border-b border-white/10 last:border-0">
                        <button class="w-full flex justify-between items-center font-advent text-left py-3 px-4 text-[#FFF9F6] hover:bg-[#FEEBDD]/10 transition-colors">
                          <span class="font-medium">{categoryName}</span>
                          <ChevronRight size={16} />
                        </button>

                        <ul class="absolute hidden group-hover/sub:block left-full top-0 w-64 ml-[2px] shadow-2xl divide-y divide-white/5">
                          {subItems.map((sub) => (
                            <li class="bg-[#513A31]">
                              <a
                                href={`/${currentLang}/procedure/${sub.slug}`}
                                class="bg-[#513A31] text-[#FFF9F6] py-3 px-4 block text-sm transition-colors font-advent hover:bg-[#FEEBDD]/10"
                              >
                                {sub.title}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </li>
                    ),
                  )}
                </ul>
              </div>
            ) : (
              <a
                href={getRelativeLocaleUrl(currentLang, item.href)}
                class="group py-2 px-2 hover:bg-[#FEEBDD]/10"
              >
                <span class="text-[#FFF9F6] text-xl font-advent">
                  {item.label}
                </span>
              </a>
            ),
          )
        }
      </div>
    </div>
  </nav>
  <div
    id="fullscreen-menu"
    class="fixed inset-0 bg-[#513A31] z-40 flex flex-col pt-32 px-6 transition-all duration-500 opacity-0 invisible overflow-y-auto"
  >
    <div class="patron absolute inset-0 opacity-10 pointer-events-none"></div>

    <nav class="relative z-10 flex flex-col gap-4 pb-10">
      {
        menuItems.map((item, index) => (
          <div
            class="menu-link-wrapper opacity-0 translate-y-4 transition-all duration-500"
            style={`transition-delay: ${index * 100}ms`}
          >
            {item.drop ? (
              /* PRIMER NIVEL: BOTÓN "PROCEDURES" */
              <div class="mobile-dropdown group/main">
                <button class="mobile-dropdown-btn w-full flex justify-between items-center text-[#FFF9F6] text-3xl font-advent hover:text-[#FEEBDD] transition-colors py-2">
                  {item.label}
                  <ChevronDown
                    size={24}
                    class="transform transition-transform duration-300 arrow-icon"
                  />
                </button>

                <div class="mobile-dropdown-content max-h-0 overflow-hidden transition-all duration-500 ease-in-out bg-[#FEEBDD]/5 rounded-lg">
                  <div class="flex flex-col gap-2 p-2">
                    {Object.entries(procedures).map(
                      ([categoryName, subItems]) => (
                        <div class="mobile-dropdown mobile-category-dropdown border-b border-[#FEEBDD]/5 last:border-0">
                          <button class="mobile-dropdown-btn w-full flex justify-between items-center py-3 px-4 text-[#FEEBDD] text-sm uppercase tracking-widest italic">
                            {categoryName}
                            <ChevronRight
                              size={16}
                              class="transform transition-transform duration-300 arrow-icon"
                            />
                          </button>

                          <div class="mobile-dropdown-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                            <ul class="flex flex-col gap-3 pb-4 px-6">
                              {subItems.map((sub) => (
                                <li>
                                  <a
                                    href={`/${currentLang}/procedure/${sub.slug}`}
                                    class="text-[#FFF9F6]/80 hover:text-[#FFF9F6] text-lg block border-l border-[#FEEBDD]/20 pl-4"
                                  >
                                    {sub.title}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        </div>
                      ),
                    )}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={getRelativeLocaleUrl(currentLang, item.href)}
                class="text-[#FFF9F6] text-3xl font-advent hover:text-[#FEEBDD] transition-colors py-2 block"
              >
                {item.label}
              </a>
            )}
          </div>
        ))
      }

      <div
        class="mt-6 pt-6 border-t border-[#FEEBDD]/10 opacity-0 translate-y-4 transition-all duration-700 delay-500"
      >
        <ContacButton />
      </div>
    </nav>
  </div>
</div>

<script>
  function initMenu() {
    const navbar = document.getElementById("main-navbar");
    const hamburgerBtn = document.getElementById("hamburger-btn");
    const hamburger = hamburgerBtn?.querySelector(".hamburger");
    const fullscreenMenu = document.getElementById("fullscreen-menu");
    const navbarProcedure = document.getElementById("navbar-procedures");

    let isOpen = false;

    function toggleMenu() {
      isOpen = !isOpen;
      hamburger?.classList.toggle("is-active");
      fullscreenMenu?.classList.toggle("open");
      document.body.classList.toggle("menu-open");
      navbarProcedure?.classList.toggle("collapsed");
      hamburgerBtn?.setAttribute("aria-expanded", String(isOpen));
    }

    hamburgerBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      toggleMenu();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) toggleMenu();
    });

    // --- Lógica de ocultar Navbar al hacer scroll ---
    let lastScrollTop = 0;
    const scrollThreshold = 10;
    let ticking = false;

    function updateNavbarVisibility() {
      const scrollTop =
        window.pageYOffset || document.documentElement.scrollTop;
      if (isOpen) {
        ticking = false;
        return;
      }

      const scrollDifference = Math.abs(scrollTop - lastScrollTop);
      if (scrollDifference >= scrollThreshold) {
        if (
          scrollTop > lastScrollTop &&
          scrollTop > (navbar?.offsetHeight || 200)
        ) {
          navbar?.classList.add("-translate-y-full");
        } else if (scrollTop < lastScrollTop) {
          navbar?.classList.remove("-translate-y-full");
        }
        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
      }
      ticking = false;
    }

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateNavbarVisibility);
          ticking = true;
        }
      },
      { passive: true },
    );

    // --- Lógica de Acordeones Anidados ---
    const setupMobileAccordion = () => {
      // Función para cerrar un dropdown y todos sus hijos recursivamente
      const closeDropdown = (dropdown: HTMLElement) => {
        const content = dropdown.querySelector<HTMLElement>(
          ":scope > .mobile-dropdown-content",
        );
        const arrow = dropdown.querySelector<HTMLElement>(
          ":scope > .mobile-dropdown-btn .arrow-icon",
        );
        if (content) {
          content.style.maxHeight = "0px";
          // Cerrar también todos los hijos anidados
          const nestedDropdowns =
            content.querySelectorAll<HTMLElement>(".mobile-dropdown");
          nestedDropdowns.forEach((nested) => closeDropdown(nested));
        }
        if (arrow) arrow.style.transform = "rotate(0deg)";
      };

      const allDropdowns =
        document.querySelectorAll<HTMLElement>(".mobile-dropdown");

      allDropdowns.forEach((dropdown) => {
        const btn = dropdown.querySelector<HTMLButtonElement>(
          ":scope > .mobile-dropdown-btn",
        );
        const content = dropdown.querySelector<HTMLElement>(
          ":scope > .mobile-dropdown-content",
        );
        const arrow = dropdown.querySelector<HTMLElement>(
          ":scope > .mobile-dropdown-btn .arrow-icon",
        );

        btn?.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();

          if (!content || !arrow) return;

          const isCurrentlyOpen =
            content.style.maxHeight && content.style.maxHeight !== "0px";

          // --- CERRAR HERMANOS DEL MISMO NIVEL ---
          const parentContainer = dropdown.parentElement;
          const siblings = parentContainer?.querySelectorAll<HTMLElement>(
            ":scope > .mobile-dropdown",
          );

          siblings?.forEach((sibling) => {
            if (sibling !== dropdown) {
              closeDropdown(sibling);
            }
          });

          // --- ABRIR / CERRAR ACTUAL ---
          if (!isCurrentlyOpen) {
            // Abrir: usamos scrollHeight para la animación inicial
            content.style.maxHeight = `${content.scrollHeight}px`;
            arrow.style.transform = "rotate(180deg)";

            // Después de la transición, cambiamos a 'none' para que los hijos
            // puedan expandirse libremente sin quedar cortados
            content.addEventListener("transitionend", function handler() {
              if (
                content.style.maxHeight &&
                content.style.maxHeight !== "0px"
              ) {
                content.style.maxHeight = "none";
              }
              content.removeEventListener("transitionend", handler);
            });
          } else {
            // Cerrar: primero fijamos la altura actual para que la transición funcione
            content.style.maxHeight = `${content.scrollHeight}px`;
            // Forzar reflow para que el browser registre el valor
            void content.offsetHeight;
            content.style.maxHeight = "0px";
            arrow.style.transform = "rotate(0deg)";

            // Cerrar todos los hijos anidados también
            const nestedDropdowns =
              content.querySelectorAll<HTMLElement>(".mobile-dropdown");
            nestedDropdowns.forEach((nested) => closeDropdown(nested));
          }
        });
      });
    };

    setupMobileAccordion();
  }

  // Ejecución inicial y soporte para Astro View Transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMenu);
  } else {
    initMenu();
  }
  document.addEventListener("astro:page-load", initMenu);
</script>

<style is:global>
  .mobile-dropdown-content {
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 0.4s ease-in-out,
      opacity 0.3s ease;
    opacity: 0;
  }

  /* Cuando está abierto (max-height != 0px), mostramos opacidad */
  .mobile-dropdown-content:not([style*="max-height: 0px"]) {
    opacity: 1;
  }

  /* Cuando max-height es 'none' (abierto completo), permitir overflow para hijos */
  .mobile-dropdown-content[style*="max-height: none"] {
    overflow: visible;
  }

  .mobile-dropdown-content[style*="max-height: 0px"] {
    opacity: 0;
  }

  /* Asegura que el botón hamburguesa esté encima de todo */
  #hamburger-btn {
    position: relative;
    z-index: 60;
  }

  /* Estado abierto del menú */
  #fullscreen-menu.open {
    opacity: 1;
    visibility: visible;
  }

  /* Animación de los links cuando el menú se abre */
  #fullscreen-menu.open .menu-link-wrapper {
    opacity: 1;
    transform: translateY(0);
  }

  /* Estilos de la hamburguesa (animación spin) */
  .hamburger.is-active .hamburger-inner,
  .hamburger.is-active .hamburger-inner::before,
  .hamburger.is-active .hamburger-inner::after {
    background-color: #feebdd !important;
  }

  /* Evitar que el scroll del fondo se mueva cuando el menú está abierto */
  body.menu-open {
    overflow: hidden;
  }

  .dropdown:hover .dropdown-menu {
    display: block;
  }

  .hamburger-inner,
  .hamburger-inner::before,
  .hamburger-inner::after {
    background-color: #feebdd !important;
  }

  .hamburger-btn:hover .hamburger-inner,
  .hamburger-btn:hover .hamburger-inner::before,
  .hamburger-btn:hover .hamburger-inner::after {
    background-color: #fff9f6 !important;
  }

  #fullscreen-menu.open {
    opacity: 1;
    visibility: visible;
  }

  #fullscreen-menu.open .menu-link,
  #fullscreen-menu.open > div > div:nth-child(3) {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }

  body.menu-open {
    overflow: hidden;
  }

  @media (max-width: 768px) {
    #fullscreen-menu > div {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
    }

    #fullscreen-menu > div > div:first-child {
      display: none;
    }

    #fullscreen-menu > div > div:last-child {
      display: none;
    }
  }

  /* Efecto de entrada escalonada */
  #fullscreen-menu.open .menu-link-wrapper {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }

  /* Efecto de brillo en hover */
  .menu-link-wrapper::before {
    content: "";
    position: absolute;
    left: -4px;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 0;
    background: linear-gradient(to bottom, transparent, #feebdd, transparent);
    border-radius: 2px;
    transition: height 0.3s ease;
  }

  .menu-link-wrapper:hover::before {
    height: 60%;
  }

  /* Animación del icono */
  @keyframes icon-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .menu-link-wrapper:hover svg {
    animation: icon-pulse 1s ease-in-out infinite;
  }

  /* Scrollbar personalizado */
  .scrollbar-custom::-webkit-scrollbar {
    width: 6px;
  }

  .scrollbar-custom::-webkit-scrollbar-track {
    background: #7d6a5d;
    border-radius: 10px;
  }

  .scrollbar-custom::-webkit-scrollbar-thumb {
    background: #feebdd;
    border-radius: 10px;
  }

  .scrollbar-custom::-webkit-scrollbar-thumb:hover {
    background: #d6c4b6;
  }

  .logo {
    /* 1. Posicionamiento: Usamos 'absolute' para fijarlo a la esquina */
    position: absolute;

    /* 2. Dimensiones: Necesitas un tamaño para que la imagen se muestre */
    width: 100px;
    height: 100px;

    /* 3. Colocación en la esquina inferior derecha */
    /* Fija el elemento a 20px del borde inferior y 20px del borde derecho */
    bottom: 20px;
    right: 20px;

    /* 4. Imagen de fondo */
    background: url("/src/assets/images/logos/logo.png");
    background-size: 100% 100%; /* El 100% hace que la imagen llene el espacio de 100x100px */
    background-repeat: no-repeat; /* Asegura que no se repita */
  }

  .patron::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    background-image:
      url("/src/assets/images/logos/logo.png"), url("/src/assets/images/logos/logo.png");

    background-size:
      40px 40px,
      40px 40px;

    background-position:
      0 0,
      20px 20px;

    background-repeat: repeat, repeat;
    background-origin: padding-box;

    opacity: 0.1;
    z-index: 1;
  }

  .patron > * {
    position: relative;
    z-index: 2;
    color: #ffffff;
  }

  #navbar-procedures.collapsed {
    max-height: 0;
    opacity: 0;
    transform: translateY(-100%);
    overflow: hidden;
  }
  /* Navbar Procedure Dropdown Animation */
  /* Navbar Procedure Dropdown Animation - Toggle Based */
  .procedure-category.active .procedure-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .procedure-category.active .procedure-btn svg {
    transform: rotate(180deg);
  }

  /* Staggered animation for items inside open dropdown */
  .procedure-category.active .dropdown-item {
    opacity: 1;
    transform: translateY(0);
  }
</style>
