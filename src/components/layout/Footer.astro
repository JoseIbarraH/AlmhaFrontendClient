---
import LogoName from "@/components/ui/LogoName.astro";
import Icon from "../ui/Icon.astro";
import { loadTranslations } from "@/lib/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import BackgroundParallax from "../ui/BackgroundParallax.astro";
import img from "@/assets/images/1150360.jpg";
import type { Settings } from "@/types/navbar";

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);

const menuItems = [
  { href: "/", label: t.navbar.links.home },
  { href: "/procedure", label: t.navbar.links.procedure },
  { href: "/about", label: t.navbar.links.about },
  { href: "/contact", label: t.navbar.links.contact },
  { href: "/blog", label: t.navbar.links.blog },
];

interface Props {
  settings: Settings | null;
}

const { settings = null } = Astro.props;

interface SocialLinkData {
  icon: string;
  label: string;
}

const socialLinksMap: Record<string, SocialLinkData> = {
  social_facebook: { icon: "facebook", label: "Facebook" },
  social_instagram: { icon: "instagram", label: "Instagram" },
  social_threads: { icon: "threads", label: "Threads" },
  social_twitter: { icon: "twitter", label: "Twitter" },
  social_linkedin: { icon: "linkedin", label: "LinkedIn" },
};

const activeSocials = settings?.social
  ? Object.entries(settings.social)
      .filter(([key, value]) => value && value.trim() !== "")
      .map(([key, value]) => ({
        url: value as string,
        ...socialLinksMap[key],
      }))
  : [];
---

<footer class="bg-[#513A31] patron text-[#FFF9F6]">
  <div class="max-w-7xl mx-auto px-6 py-12 lg:py-16">
    <!-- Grid principal -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 lg:gap-8">
      <!-- Columna 1: Logo y Redes Sociales -->
      <div class="flex flex-col items-center md:items-start gap-6">
        <LogoName size="xl" class="text-[#FEEBDD]" />

        <p class="text-[#D6C4B6] text-center md:text-left max-w-xs">
          Cuidando tu salud con profesionalismo y dedicación.
        </p>

        <div class="flex gap-4">
          {
            activeSocials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="w-10 h-10 flex justify-center items-center rounded-full
                     bg-[#7D6A5D] hover:bg-[#FEEBDD]
                     text-[#FFF9F6] hover:text-[#513A31]
                     transition-all duration-300 hover:scale-110"
              >
                <Icon name={social.icon} class="w-5 h-5" />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Columna 2: Navegación -->
      <div class="flex flex-col gap-6">
        <h3 class="text-[#FEEBDD] text-lg font-bold mb-2">Navegación</h3>

        <nav class="flex flex-col gap-3">
          {
            menuItems.map((item) => (
              <a
                href={getRelativeLocaleUrl(currentLang, item.href)}
                class="group flex items-center gap-3 text-[#D6C4B6] hover:text-[#FEEBDD]
                     transition-all duration-300 w-fit"
              >
                <span class="w-0 h-0.5 bg-[#FEEBDD] group-hover:w-6 transition-all duration-300" />
                <span class="group-hover:translate-x-1 transition-transform duration-300">
                  {item.label}
                </span>
              </a>
            ))
          }
        </nav>
      </div>

      <!-- Columna 3: Contacto -->
      <div class="flex flex-col gap-6">
        <h3 class="text-[#FEEBDD] text-lg font-bold mb-2">Contacto</h3>

        <div class="flex flex-col gap-4 text-[#D6C4B6]">
          <div class="flex items-start gap-3">
            <Icon name="map-pin" class="w-5 h-5 text-[#FEEBDD] shrink-0 mt-1" />
            <p class="text-sm">
              {settings?.contact.contact_location || "Ubicación pendiente"}
            </p>
          </div>

          <div class="flex items-center gap-3">
            <Icon name="phone" class="w-5 h-5 text-[#FEEBDD] shrink-0" />
            <a
              href={`tel:${settings?.contact.contact_phone}`}
              class="text-sm hover:text-[#FEEBDD] transition-colors"
            >
              {settings?.contact.contact_phone || "Teléfono pendiente"}
            </a>
          </div>

          <div class="flex items-center gap-3">
            <Icon name="mail" class="w-5 h-5 text-[#FEEBDD] shrink-0" />
            <a
              href={`mailto:${settings?.contact.contact_email}`}
              class="text-sm hover:text-[#FEEBDD] transition-colors"
            >
              {settings?.contact.contact_email || "Email pendiente"}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="my-8 h-px bg-[#7D6A5D]"></div>

    <!-- Copyright -->
    <div
      class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-[#D6C4B6]"
    >
      <p>
        © {new Date().getFullYear()} Almha. Todos los derechos reservados.
      </p>

      <div class="flex gap-6">
        <a href="#" class="hover:text-[#FEEBDD] transition-colors">
          Política de Privacidad
        </a>
        <a href="#" class="hover:text-[#FEEBDD] transition-colors">
          Términos de Uso
        </a>
      </div>
    </div>
  </div>
  <div>
    <BackgroundParallax fullScreen={false} bg={img.src} />
  </div>
</footer>

<style>
  /* Animación de entrada para los enlaces */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  footer nav a {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  footer nav a:nth-child(1) {
    animation-delay: 0.1s;
  }
  footer nav a:nth-child(2) {
    animation-delay: 0.2s;
  }
  footer nav a:nth-child(3) {
    animation-delay: 0.3s;
  }
  footer nav a:nth-child(4) {
    animation-delay: 0.4s;
  }
  footer nav a:nth-child(5) {
    animation-delay: 0.5s;
  }

  .patron {
    width: 100%;
    position: relative;
    background-color: #6b5449;
    overflow: hidden;
  }

  .patron::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    background-image:
      url("/src/assets/images/logo.png"), url("/src/assets/images/logo.png");

    background-size:
      40px 40px,
      40px 40px;

    background-position:
      0 0,
      20px 20px;

    background-repeat: repeat, repeat;
    background-origin: padding-box;

    opacity: 0.1;
    z-index: 1;
  }

  .patron > * {
    position: relative;
    z-index: 2;
    color: #ffffff;
  }
</style>
