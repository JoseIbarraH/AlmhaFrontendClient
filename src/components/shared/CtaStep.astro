---
import { loadTranslations } from "@/lib/i18n";

const currentLang = Astro.currentLocale || "es";
const t = await loadTranslations(currentLang);

interface Props {
  title?: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="p-6">
  <div
    class="relative overflow-hidden rounded-4xl p-12
           bg-linear-to-br from-[#513A31] via-[#6A554A] to-[#7D6A5D]
           shadow-2xl
           timeline-view animate-blurred-fade-in animate-range-[entry_10%_contain_30%]"
  >
    <!-- Decorative lights -->
    <div
      class="pointer-events-none absolute -top-20 -right-20 w-md h-122
             bg-[#FEEBDD]/15 rounded-full blur-[120px]"
    >
    </div>

    <div
      class="pointer-events-none absolute -bottom-24 -left-24 w-88 h-88
             bg-[#D6C4B6]/10 rounded-full blur-[100px]"
    >
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-3xl mx-auto text-center">
      <h2
        class="text-4xl md:text-5xl font-light tracking-tight
               text-[#FFF9F6] mb-5"
      >
        {title ?? t?.home?.cta_step?.title}
      </h2>

      <p
        class="text-lg md:text-xl leading-relaxed
               text-[#D6C4B6] mb-10"
      >
        {subtitle ?? t?.home?.cta_step?.description}
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <!-- Primary CTA -->
        <button
          class="px-9 py-4 rounded-xl font-bold text-lg
                 bg-[#FEEBDD] text-[#513A31]
                 shadow-lg shadow-[#513A31]/30
                 hover:bg-[#FFF9F6] hover:scale-[1.03]
                 active:scale-[0.98]
                 transition-all duration-300"
        >
          {t?.home?.cta_step?.primary_cta}
        </button>

        <!-- Secondary CTA -->
        <button
          class="px-9 py-4 rounded-xl font-bold text-lg
                 text-[#FFF9F6]
                 bg-white/10 backdrop-blur-md
                 border border-[#D6C4B6]/40
                 hover:bg-white/20 hover:border-[#FEEBDD]/60
                 active:scale-[0.98]
                 transition-all duration-300"
        >
          {t?.home?.cta_step?.secondary_cta}
        </button>
      </div>
    </div>
  </div>
</div>
