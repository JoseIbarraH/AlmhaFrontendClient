---
import Layout from "@/layouts/Layout.astro";
import ContactForm from "@/components/partials/contact/ContactForm.astro";
import ContactInfo from "@/components/partials/contact/ContactInfo.astro";
import { loadTranslations } from "@/lib/i18n";

interface ContactSettings {
  phone?: string;
  email?: string;
  location?: string;
  whatsapp_number?: string;
  whatsapp_active?: boolean;
  whatsapp_message?: string;
  whatsapp_open_new_tab?: boolean;
}

const { api } = Astro.locals;
let settings: ContactSettings = {};
let procedures: { value: string; label: string }[] = [];

const lang = Astro.currentLocale || "es";
const t = await loadTranslations(lang);

try {
  const { data } = await api.get(`/api/client/contact-data?lang=${lang}`);
  if (data.success) {
    settings = data.data.settings;
    procedures = (data.data.procedures as Array<{ title: string }>).map((p) => ({
      value: p.title,
      label: p.title,
    }));
  }
} catch (error) {
  console.error("Error fetching contact data:", error);
}

const {
  phone = t?.contact?.defaults?.phone ?? "+57 300 123 4567",
  email = t?.contact?.defaults?.email ?? "info@almha.com",
  location = t?.contact?.defaults?.location ?? "",
  whatsapp_number,
  whatsapp_active,
  whatsapp_open_new_tab,
} = settings;

const formattedLocation = location.replace(/\n/g, "<br/>");

let whatsappLink = "";
if (whatsapp_number) {
  const cleanNumber = String(whatsapp_number).replace(/\D/g, "");
  whatsappLink = `https://wa.me/${cleanNumber}`;
}
---

<Layout>
  <div id="contact" class="tab-content">
    <!-- HERO -->
    <section
      class="relative h-[45vh] min-h-[420px] bg-linear-to-br from-[#513A31] to-[#7D6A5D] overflow-hidden"
    >
      <div class="absolute inset-0 bg-black/20"></div>
      <div
        class="absolute -top-24 -right-24 w-lg h-128 bg-[#FEEBDD]/10 rounded-full blur-3xl"
      >
      </div>

      <div class="relative z-10 h-full flex items-center max-w-7xl mx-auto px-6">
        <div class="max-w-2xl">
          <h1
            class="text-5xl md:text-6xl font-semibold tracking-tight text-[#FFF9F6] mb-6"
          >
            {t?.contact?.hero?.title}
          </h1>
          <p class="text-lg md:text-xl text-[#FEEBDD]/90 leading-relaxed">
            {t?.contact?.hero?.subtitle}
          </p>
        </div>
      </div>
    </section>

    <!-- CONTENT -->
    <section class="py-24 bg-[#FFF9F6]">
      <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-5 gap-14">
        <div class="lg:col-span-3">
          <ContactForm
            procedures={procedures}
            whatsappLink={whatsappLink}
            whatsappActive={whatsapp_active}
            whatsappOpenNewTab={whatsapp_open_new_tab}
          />
        </div>

        <div class="lg:col-span-2">
          <ContactInfo
            phone={phone}
            email={email}
            formattedLocation={formattedLocation}
          />
        </div>
      </div>
    </section>
  </div>

  <!-- Contact form translation strings consumed by the JS init -->
  <script
    is:inline
    type="application/json"
    id="i18n-contact-form"
    set:html={JSON.stringify({
      success: t?.contact?.messages?.success ?? "",
      validationError: t?.contact?.messages?.validation_error ?? "",
      rateLimit: t?.contact?.messages?.rate_limit ?? "",
      genericError: t?.contact?.messages?.generic_error ?? "",
      connectionError: t?.contact?.messages?.connection_error ?? "",
      submitLoading: t?.contact?.form?.submit_loading ?? "",
    })}
  />

  <script>
    import { initContactForm } from "@/lib/contactForm";

    const apiUrl = import.meta.env.PUBLIC_API_URL ?? "";
    const boot = () => initContactForm(apiUrl);

    document.addEventListener("DOMContentLoaded", boot);
    document.addEventListener("astro:page-load", boot);
  </script>
</Layout>
