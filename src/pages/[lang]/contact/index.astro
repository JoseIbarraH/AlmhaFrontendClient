---
import Layout from "@/layouts/Layout.astro";
import Combobox from "@/components/ui/Combobox.astro";
import { countryCodes } from "@/data/countries";
import { Phone, MapPin } from "@lucide/astro";

interface ContactSettings {
  phone?: string;
  email?: string;
  location?: string;
  whatsapp_number?: string;
  whatsapp_active?: boolean;
  whatsapp_message?: string;
  whatsapp_open_new_tab?: boolean;
}

const { api } = Astro.locals;
let settings: ContactSettings = {};
let procedures: { value: string; label: string }[] = [];

const lang = Astro.currentLocale || "es";

try {
  const { data } = await api.get(`/api/client/contact-data?lang=${lang}`);
  if (data.success) {
    settings = data.data.settings;
    procedures = data.data.procedures.map((p: any) => ({
      value: p.title,
      label: p.title,
    }));
  }
} catch (error) {
  console.error("Error fetching contact data:", error);
}

const {
  phone = "+57 300 123 4567",
  email = "info@almha.com",
  location = "Calle Principal #123\nCartagena, Bolívar\nColombia",
  whatsapp_number,
  whatsapp_active,
  whatsapp_open_new_tab,
} = settings;

// Format location for display (handle newlines)
const formattedLocation = location.replace(/\n/g, "<br/>");

let whatsappLink = "";
if (whatsapp_number) {
  const cleanNumber = String(whatsapp_number).replace(/\D/g, "");
  whatsappLink = `https://wa.me/${cleanNumber}`;
}
---

<Layout>
  <div id="contact" class="tab-content">
    <!-- HERO -->
    <section
      class="relative h-[45vh] min-h-[420px] bg-linear-to-br from-[#513A31] to-[#7D6A5D] overflow-hidden"
    >
      <!-- Overlay -->
      <div class="absolute inset-0 bg-black/20"></div>

      <!-- Glow decorativo -->
      <div
        class="absolute -top-24 -right-24 w-lg h-128 bg-[#FEEBDD]/10 rounded-full blur-3xl"
      >
      </div>

      <div
        class="relative z-10 h-full flex items-center max-w-7xl mx-auto px-6"
      >
        <div class="max-w-2xl">
          <h1
            class="text-5xl md:text-6xl font-semibold tracking-tight text-[#FFF9F6] mb-6"
          >
            Contáctenos
          </h1>
          <p class="text-lg md:text-xl text-[#FEEBDD]/90 leading-relaxed">
            Tu consulta es el primer paso hacia una transformación segura,
            profesional y personalizada.
          </p>
        </div>
      </div>
    </section>

    <!-- CONTACTO -->
    <section class="py-24 bg-[#FFF9F6]">
      <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-5 gap-14">
        <!-- FORMULARIO -->
        <div class="lg:col-span-3">
          <div class="bg-white rounded-3xl p-12 shadow-2xl">
            <h2 class="text-3xl font-semibold text-[#513A31] mb-2">
              Envíanos un mensaje
            </h2>
            <p class="text-[#7D6A5D] mb-10">
              Nuestro equipo se pondrá en contacto contigo muy pronto
            </p>

            <!-- Divider -->
            <div class="flex items-center gap-4 mb-10">
              <div class="h-px flex-1 bg-[#D6C4B6]/60"></div>
              <span class="text-sm text-[#7D6A5D] uppercase tracking-widest">
                Contacto
              </span>
              <div class="h-px flex-1 bg-[#D6C4B6]/60"></div>
            </div>

            <form id="contactForm" class="space-y-8">
              <div class="grid md:grid-cols-2 gap-2">
                <div>
                  <label
                    class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide"
                    >Nombre *</label
                  >
                  <input
                    type="text"
                    name="name"
                    placeholder="Tu nombre"
                    class="w-full px-4 py-3.5 bg-[#FFF9F6]
                           border border-[#D6C4B6]/70 rounded-xl
                           focus:border-[#7D6A5D]
                           focus:ring-2 focus:ring-[#FEEBDD]/60
                           outline-none transition"
                  />
                </div>

                <div>
                  <label
                    class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide"
                    >Email *</label
                  >
                  <input
                    type="email"
                    name="email"
                    placeholder="tu@email.com"
                    class="w-full px-4 py-3.5 bg-[#FFF9F6]
                           border border-[#D6C4B6]/70 rounded-xl
                           focus:border-[#7D6A5D]
                           focus:ring-2 focus:ring-[#FEEBDD]/60
                           outline-none transition"
                  />
                </div>
              </div>

              <div class="grid md:grid-cols-2 gap-2">
                <div>
                  <label
                    class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide"
                    >Teléfono *</label
                  >
                  <div class="flex gap-3">
                    <div class="w-1/3">
                      <input
                        type="text"
                        name="countryCode"
                        id="countryCodeInput"
                        list="countryCodes"
                        placeholder="+57"
                        value="+57"
                        pattern="\+?[0-9]*"
                        title="Solo se permiten números y el signo +"
                        class="w-full px-4 py-3.5 bg-[#FFF9F6]
                               border border-[#D6C4B6]/70 rounded-xl
                               focus:border-[#7D6A5D]
                               focus:ring-2 focus:ring-[#FEEBDD]/60
                               outline-none transition"
                      />
                      <datalist id="countryCodes">
                        {
                          countryCodes.map((country) => (
                            <option value={country.code}>{country.name}</option>
                          ))
                        }
                      </datalist>
                    </div>
                    <input
                      type="tel"
                      name="phone"
                      id="phoneInput"
                      placeholder="300 123 4567"
                      pattern="[0-9\s]*"
                      title="Solo se permiten números"
                      class="w-2/3 px-4 py-3.5 bg-[#FFF9F6]
                             border border-[#D6C4B6]/70 rounded-xl
                             focus:border-[#7D6A5D]
                             focus:ring-2 focus:ring-[#FEEBDD]/60
                             outline-none transition"
                    />
                  </div>
                </div>

                <div>
                  <label
                    class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide"
                  >
                    Procedimiento/otros
                  </label>

                  <Combobox
                    options={procedures}
                    name="procedure"
                    placeholder="Seleccionar procedimiento..."
                  />
                </div>
              </div>

              <div>
                <label
                  class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide"
                  >Mensaje *</label
                >
                <textarea
                  rows="5"
                  name="message"
                  placeholder="Cuéntanos tus expectativas..."
                  class="w-full px-4 py-3.5 bg-[#FFF9F6]
                         border border-[#D6C4B6]/70 rounded-xl
                         focus:border-[#7D6A5D]
                         focus:ring-2 focus:ring-[#FEEBDD]/60
                         outline-none resize-none transition"
                ></textarea>
              </div>

              <div class="flex flex-col gap-4">
                <button
                  type="submit"
                  class="w-full px-8 py-4
                         bg-linear-to-r from-[#513A31] to-[#7D6A5D]
                         text-[#FEEBDD]
                         font-semibold tracking-wide
                         rounded-xl
                         hover:scale-[1.02]
                         hover:shadow-2xl
                         active:scale-[0.98]
                         transition-all duration-300"
                >
                  Enviar mensaje
                </button>

                {
                  whatsapp_active && whatsapp_number && (
                    <a
                      href={whatsappLink}
                      target={whatsapp_open_new_tab ? "_blank" : "_self"}
                      rel={
                        whatsapp_open_new_tab
                          ? "noopener noreferrer"
                          : undefined
                      }
                      class="w-full px-8 py-4 flex items-center justify-center gap-2
                           bg-[#25D366] text-white
                           font-semibold tracking-wide
                           rounded-xl
                           hover:scale-[1.02]
                           hover:shadow-2xl
                           hover:bg-[#20bd5a]
                           active:scale-[0.98]
                           transition-all duration-300 shadow-md"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
                      </svg>
                      Contactar por WhatsApp
                    </a>
                  )
                }
              </div>
            </form>
          </div>
        </div>

        <!-- INFO -->
        <div class="lg:col-span-2 space-y-8">
            <!-- Card -->
            <div
              class="bg-white rounded-2xl p-8
                   shadow-[0_10px_40px_rgba(0,0,0,0.08)]
                   hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)]
                   transition"
            >
              <div
                class="w-12 h-12 bg-linear-to-br from-[#FEEBDD] to-[#EAD3C2]
                     rounded-xl flex items-center justify-center mb-5 shadow-md"
              >
                <MapPin class="text-[#513A31]" />
              </div>
              <h3 class="text-xl font-semibold text-[#513A31] mb-2">
                Ubicación
              </h3>
              <p
                class="text-[#7D6A5D] leading-relaxed"
                set:html={formattedLocation}
              />
            </div>

            <div
              class="bg-white rounded-2xl p-8
                   shadow-[0_10px_40px_rgba(0,0,0,0.08)]
                   hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)]
                   transition"
            >
              <div
                class="w-12 h-12 bg-linear-to-br from-[#FEEBDD] to-[#EAD3C2]
                     rounded-xl flex items-center justify-center mb-5 shadow-md"
              >
                <Phone class="text-[#513A31]" />
              </div>
              <h3 class="text-xl font-semibold text-[#513A31] mb-2">
                Teléfono
              </h3>
              <p class="text-[#7D6A5D]">{phone}</p>
              <p class="text-sm text-[#7D6A5D] mt-2">
                Lun–Vie · 8:00 AM – 6:00 PM
              </p>
            </div>

            <div
              class="bg-white rounded-2xl p-8
                   shadow-[0_10px_40px_rgba(0,0,0,0.08)]
                   hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)]
                   transition"
            >
              <div
                class="w-12 h-12 bg-linear-to-br from-[#FEEBDD] to-[#EAD3C2]
                     rounded-xl flex items-center justify-center mb-5 shadow-md"
              >
                ✉️
              </div>
              <h3 class="text-xl font-semibold text-[#513A31] mb-2">Email</h3>
              <p class="text-[#7D6A5D]">{email}</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed bottom-6 right-6 z-100 flex flex-col gap-3 pointer-events-none"></div>

  <script>
    function showToast(message: string, type: "success" | "error" = "success") {
      const container = document.getElementById("toast-container");
      if (!container) return;

      const toast = document.createElement("div");
      toast.className = `transform transition-all duration-300 translate-y-8 opacity-0 flex items-center gap-4 px-6 py-4 rounded-2xl shadow-xl pointer-events-auto border-l-4 ${
        type === "success"
          ? "bg-white border-[#513A31] text-[#513A31]"
          : "bg-white border-[#ef4444] text-[#513A31]"
      }`;

      const iconHtml = type === "success"
        ? `<div class="flex-shrink-0 w-8 h-8 rounded-full bg-[#FEEBDD] flex items-center justify-center text-[#513A31]"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg></div>`
        : `<div class="flex-shrink-0 w-8 h-8 rounded-full bg-red-100 flex items-center justify-center text-red-500"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg></div>`;

      toast.innerHTML = `
        ${iconHtml}
        <div class="flex-1 min-w-0">
          <p class="font-bold text-sm leading-tight">${type === "success" ? "¡Éxito!" : "Error"}</p>
          <p class="text-sm text-[#7D6A5D] mt-0.5 break-words">${message}</p>
        </div>
        <button onclick="this.parentElement.remove()" class="flex-shrink-0 ml-2 text-[#D6C4B6] hover:text-[#7D6A5D] transition-colors focus:outline-none">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      `;

      container.appendChild(toast);

      // Animate in
      requestAnimationFrame(() => {
        toast.classList.remove("translate-y-8", "opacity-0");
        toast.classList.add("translate-y-0", "opacity-100");
      });

      // Auto remove after 5 seconds
      setTimeout(() => {
        toast.classList.remove("translate-y-0", "opacity-100");
        toast.classList.add("translate-y-8", "opacity-0");
        setTimeout(() => toast.remove(), 300);
      }, 5000);
    }

    function setupContactForm() {
      const form = document.getElementById("contactForm") as HTMLFormElement;
      if (!form) return;

      // Evitar que se adjunte múltiple veces por transiciones de página
      if (form.hasAttribute("data-initialized")) return;
      form.setAttribute("data-initialized", "true");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const submitBtn = form.querySelector(
          'button[type="submit"]',
        ) as HTMLButtonElement;
        if (!submitBtn) return;

        const originalText = submitBtn.innerText;
        submitBtn.innerText = "Enviando...";
        submitBtn.disabled = true;

        try {
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());

          const webhookUrl =
            "https://n8n.almhaplasticsurgery.com/webhook-test/9df422fc-3478-4160-9949-fb77f3b98ca6";

          const response = await fetch(webhookUrl, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(data),
          });

          if (response.ok) {
            showToast(
              "Mensaje enviado con éxito. Nuestro equipo se pondrá en contacto pronto.",
              "success"
            );
            form.reset();
          } else {
            showToast("Hubo un error al enviar el mensaje. Intente de nuevo.", "error");
          }
        } catch (error) {
          console.error("Error submitting form:", error);
          showToast("Error de conexión al enviar el formulario. Intente de nuevo.", "error");
        } finally {
          submitBtn.innerText = originalText;
          submitBtn.disabled = false;
        }
      });

      // Validación para el código de país (solo permite + al inicio y números)
      const countryCodeInput = document.getElementById("countryCodeInput") as HTMLInputElement;
      if (countryCodeInput) {
        // Remover caracteres no válidos mientras el usuario escribe
        countryCodeInput.addEventListener("input", (e) => {
          const input = e.target as HTMLInputElement;
          // Permite '+' al principio y solo dígitos después
          input.value = input.value.replace(/[^\+0-9]/g, '');
          // Si hay más de un '+', conservar solo el primero
          if (input.value.indexOf('+') > 0 || (input.value.match(/\+/g) || []).length > 1) {
             const hasPlus = input.value.startsWith('+');
             const digits = input.value.replace(/\D/g, '');
             input.value = hasPlus ? '+' + digits : digits;
          }
        });

        // Validar y limpiar on blur (cuando pierde el foco)
        countryCodeInput.addEventListener("blur", (e) => {
          const input = e.target as HTMLInputElement;
          const datalist = document.getElementById('countryCodes') as HTMLDataListElement | null;
          const matchingOption = Array.from(datalist?.options || [])
            .find((opt) => {
               const option = opt as HTMLOptionElement;
               return option.value === input.value || option.text === input.value;
            }) as HTMLOptionElement | undefined;

          if (matchingOption) {
             input.value = matchingOption.value;
          } else {
             // Si no coincide con ninguna opción, limpiamos letras/símbolos y forzamos solo + y numeros
             const hasPlus = input.value.startsWith('+');
             const digits = input.value.replace(/\D/g, '');
             input.value = hasPlus ? '+' + digits : digits;

             // Si queda vacío después de limpiar, poner el valor por defecto
             if (!input.value) {
               input.value = '+57';
             }
          }
        });
      }

      // Validación para el teléfono (solo permite números)
      const phoneInput = document.getElementById("phoneInput") as HTMLInputElement;
      if (phoneInput) {
        phoneInput.addEventListener("input", (e) => {
          const input = e.target as HTMLInputElement;
          // Permitir números y espacios intermedios
          input.value = input.value.replace(/[^\d\s]/g, '');
        });
        phoneInput.addEventListener("blur", (e) => {
          const input = e.target as HTMLInputElement;
          input.value = input.value.trim();
        });
      }
    }

    // Inicializar en la primera carga y en las navegaciones subsiguientes de Astro
    document.addEventListener("DOMContentLoaded", setupContactForm);
    document.addEventListener("astro:page-load", setupContactForm);
  </script>
</Layout>
