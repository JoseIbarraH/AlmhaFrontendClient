---
import Layout from "@/layouts/Layout.astro";
import Combobox from "@/components/ui/Combobox.astro";

interface ContactSettings {
  phone?: string;
  email?: string;
  location?: string;
  whatsapp_number?: string;
  whatsapp_active?: boolean;
  whatsapp_message?: string;
  whatsapp_open_new_tab?: boolean;
}

const API_URL = import.meta.env.PUBLIC_API_URL;
let settings: ContactSettings = {};
let procedures: { value: string; label: string }[] = [];

const lang = Astro.currentLocale || "es";

try {
  const response = await fetch(
    `${API_URL}/api/client/contact-data?lang=${lang}`,
  );
  const data = await response.json();
  if (data.success) {
    settings = data.data.settings;
    procedures = data.data.procedures.map((p: any) => ({
      value: p.title,
      label: p.title,
    }));
  }
} catch (error) {
  console.error("Error fetching contact data:", error);
}

const {
  phone = "+57 300 123 4567",
  email = "info@almha.com",
  location = "Calle Principal #123\nCartagena, Bolívar\nColombia",
  whatsapp_number,
  whatsapp_active,
  whatsapp_message,
  whatsapp_open_new_tab
} = settings;

// Format location for display (handle newlines)
const formattedLocation = location.replace(/\n/g, "<br/>");

let whatsappLink = "";
if (whatsapp_number) {
  const cleanNumber = String(whatsapp_number).replace(/\D/g, "");
  whatsappLink = `https://wa.me/${cleanNumber}`;
}
---

<Layout>
  <div id="contact" class="tab-content">
    <!-- HERO -->
    <section
      class="relative h-[45vh] min-h-[420px] bg-linear-to-br from-[#513A31] to-[#7D6A5D] overflow-hidden"
    >
      <!-- Overlay -->
      <div class="absolute inset-0 bg-black/20"></div>

      <!-- Glow decorativo -->
      <div
        class="absolute -top-24 -right-24 w-lg h-128 bg-[#FEEBDD]/10 rounded-full blur-3xl"
      >
      </div>

      <div
        class="relative z-10 h-full flex items-center max-w-7xl mx-auto px-6"
      >
        <div class="max-w-2xl">
          <h1
            class="text-5xl md:text-6xl font-semibold tracking-tight text-[#FFF9F6] mb-6"
          >
            Contáctenos
          </h1>
          <p class="text-lg md:text-xl text-[#FEEBDD]/90 leading-relaxed">
            Tu consulta es el primer paso hacia una transformación segura,
            profesional y personalizada.
          </p>
        </div>
      </div>
    </section>

    <!-- CONTACTO -->
    <section class="py-24 bg-[#FFF9F6]">
      <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-5 gap-14">
        <!-- FORMULARIO -->
        <div class="lg:col-span-3">
          <div class="bg-white rounded-3xl p-12 shadow-2xl">
            <h2 class="text-3xl font-semibold text-[#513A31] mb-2">
              Envíanos un mensaje
            </h2>
            <p class="text-[#7D6A5D] mb-10">
              Nuestro equipo se pondrá en contacto contigo muy pronto
            </p>

            <!-- Divider -->
            <div class="flex items-center gap-4 mb-10">
              <div class="h-px flex-1 bg-[#D6C4B6]/60"></div>
              <span class="text-sm text-[#7D6A5D] uppercase tracking-widest">
                Contacto
              </span>
              <div class="h-px flex-1 bg-[#D6C4B6]/60"></div>
            </div>

            <form class="space-y-8">
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label
                    class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide"
                    >Nombre *</label
                  >
                  <input
                    type="text"
                    name="name"
                    placeholder="Tu nombre"
                    class="w-full px-4 py-3.5 bg-[#FFF9F6]
                           border border-[#D6C4B6]/70 rounded-xl
                           focus:border-[#7D6A5D]
                           focus:ring-2 focus:ring-[#FEEBDD]/60
                           outline-none transition"
                  />
                </div>

                <div>
                  <label
                    class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide"
                    >Email *</label
                  >
                  <input
                    type="email"
                    name="email"
                    placeholder="tu@email.com"
                    class="w-full px-4 py-3.5 bg-[#FFF9F6]
                           border border-[#D6C4B6]/70 rounded-xl
                           focus:border-[#7D6A5D]
                           focus:ring-2 focus:ring-[#FEEBDD]/60
                           outline-none transition"
                  />
                </div>
              </div>

              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label
                    class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide"
                    >Teléfono *</label
                  >
                  <input
                    type="tel"
                    name="phone"
                    placeholder="+57 300 123 4567"
                    class="w-full px-4 py-3.5 bg-[#FFF9F6]
                           border border-[#D6C4B6]/70 rounded-xl
                           focus:border-[#7D6A5D]
                           focus:ring-2 focus:ring-[#FEEBDD]/60
                           outline-none transition"
                  />
                </div>

                <div>
                  <label class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide">
                    Procedimiento/otros
                  </label>

                  <Combobox
                    options={procedures}
                    name="procedure"
                    placeholder="Seleccionar procedimiento..."
                  />
                </div>
              </div>

              <div>
                <label
                  class="block text-xs font-semibold text-[#513A31] mb-2 uppercase tracking-wide"
                  >Mensaje *</label
                >
                <textarea
                  rows="5"
                  name="message"
                  placeholder="Cuéntanos tus expectativas..."
                  class="w-full px-4 py-3.5 bg-[#FFF9F6]
                         border border-[#D6C4B6]/70 rounded-xl
                         focus:border-[#7D6A5D]
                         focus:ring-2 focus:ring-[#FEEBDD]/60
                         outline-none resize-none transition"
                ></textarea>
              </div>

              <div class="flex flex-col gap-4">
                <button
                  type="submit"
                  class="w-full px-8 py-4
                         bg-linear-to-r from-[#513A31] to-[#7D6A5D]
                         text-[#FEEBDD]
                         font-semibold tracking-wide
                         rounded-xl
                         hover:scale-[1.02]
                         hover:shadow-2xl
                         active:scale-[0.98]
                         transition-all duration-300"
                >
                  Enviar mensaje
                </button>

                {whatsapp_active && whatsapp_number && (
                  <a
                    href={whatsappLink}
                    target={whatsapp_open_new_tab ? "_blank" : "_self"}
                    rel={whatsapp_open_new_tab ? "noopener noreferrer" : undefined}
                    class="w-full px-8 py-4 flex items-center justify-center gap-2
                           bg-[#25D366] text-white
                           font-semibold tracking-wide
                           rounded-xl
                           hover:scale-[1.02]
                           hover:shadow-2xl
                           hover:bg-[#20bd5a]
                           active:scale-[0.98]
                           transition-all duration-300 shadow-md"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                    </svg>
                    Contactar por WhatsApp
                  </a>
                )}
              </div>
          </div>
        </div>

        <!-- INFO -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Card -->
          <div
            class="bg-white rounded-2xl p-8
                   shadow-[0_10px_40px_rgba(0,0,0,0.08)]
                   hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)]
                   transition"
          >
            <div
              class="w-12 h-12 bg-linear-to-br from-[#FEEBDD] to-[#EAD3C2]
                     rounded-xl flex items-center justify-center mb-5 shadow-md"
            >
              📍
            </div>
            <h3 class="text-xl font-semibold text-[#513A31] mb-2">Ubicación</h3>
            <p
              class="text-[#7D6A5D] leading-relaxed"
              set:html={formattedLocation}
            />
          </div>

          <div
            class="bg-white rounded-2xl p-8
                   shadow-[0_10px_40px_rgba(0,0,0,0.08)]
                   hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)]
                   transition"
          >
            <div
              class="w-12 h-12 bg-linear-to-br from-[#FEEBDD] to-[#EAD3C2]
                     rounded-xl flex items-center justify-center mb-5 shadow-md"
            >
              📞
            </div>
            <h3 class="text-xl font-semibold text-[#513A31] mb-2">Teléfono</h3>
            <p class="text-[#7D6A5D]">{phone}</p>
            <p class="text-sm text-[#7D6A5D] mt-2">
              Lun–Vie · 8:00 AM – 6:00 PM
            </p>
          </div>

          <div
            class="bg-white rounded-2xl p-8
                   shadow-[0_10px_40px_rgba(0,0,0,0.08)]
                   hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)]
                   transition"
          >
            <div
              class="w-12 h-12 bg-linear-to-br from-[#FEEBDD] to-[#EAD3C2]
                     rounded-xl flex items-center justify-center mb-5 shadow-md"
            >
              ✉️
            </div>
            <h3 class="text-xl font-semibold text-[#513A31] mb-2">Email</h3>
            <p class="text-[#7D6A5D]">{email}</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
