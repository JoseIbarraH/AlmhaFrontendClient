---
import Layout from "@/layouts/Layout.astro";
import { loadTranslations } from "@/lib/i18n";
import { CheckCircle2, XCircle, AlertTriangle } from "@lucide/astro";

type Status = "confirmed" | "failed" | "invalid";

const lang = Astro.currentLocale || "es";
const t = await loadTranslations(lang);

const token = (Astro.url.searchParams.get("token") ?? "").trim();
const { api } = Astro.locals;

let status: Status;

if (!token) {
  status = "invalid";
} else {
  try {
    const { data } = await api.get(`/api/client/subscribe/confirm?token=${encodeURIComponent(token)}`);
    const apiStatus = data?.data?.status;
    status = apiStatus === "confirmed" ? "confirmed" : "failed";
  } catch (error) {
    const err = error as { response?: { data?: { status?: string }; status?: number } };
    const apiStatus = err.response?.data?.status;
    if (apiStatus === "invalid" || err.response?.status === 400) {
      status = "invalid";
    } else {
      status = "failed";
    }
  }
}

const messages = t.subscribe?.confirm?.[status] ?? {
  title: "",
  subtitle: "",
  cta: "Volver al inicio",
};

const visual = {
  confirmed: { Icon: CheckCircle2, bg: "from-[#FEEBDD] to-[#EAD3C2]", iconColor: "text-[#513A31]" },
  failed: { Icon: XCircle, bg: "from-red-100 to-red-200", iconColor: "text-red-600" },
  invalid: { Icon: AlertTriangle, bg: "from-amber-100 to-amber-200", iconColor: "text-amber-600" },
}[status];
---

<Layout title={messages.title}>
  <section class="bg-[#FFF9F6] min-h-[80vh] flex items-center justify-center py-24 px-6">
    <div class="max-w-xl w-full text-center">
      <div
        class:list={[
          "w-24 h-24 mx-auto rounded-3xl flex items-center justify-center mb-8 shadow-xl bg-linear-to-br",
          visual.bg,
        ]}
      >
        <visual.Icon class={`w-12 h-12 ${visual.iconColor}`} stroke-width={1.5} />
      </div>

      <h1 class="text-3xl md:text-4xl font-semibold text-[#513A31] mb-4 tracking-tight">
        {messages.title}
      </h1>

      <p class="text-[#7D6A5D] text-lg leading-relaxed mb-10 max-w-md mx-auto">
        {messages.subtitle}
      </p>

      <a
        href={`/${lang}/`}
        class="inline-block px-8 py-4 bg-linear-to-r from-[#513A31] to-[#7D6A5D] text-[#FEEBDD] font-semibold tracking-wide rounded-xl shadow-lg hover:scale-[1.02] hover:shadow-2xl active:scale-[0.98] transition-all duration-300"
      >
        {messages.cta}
      </a>
    </div>
  </section>
</Layout>
