---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/partials/procedure/Header.astro";
import WhatIs from "@/components/partials/procedure/WhatIs.astro";
import Technique from "@/components/partials/procedure/Technique.astro";
import Preparation from "@/components/partials/procedure/Preparation.astro";
import Recovery from "@/components/partials/procedure/Recovery.astro";
import RecoveryPhase from "@/components/partials/procedure/RecoveryPhase.astro";
import PostOperative from "@/components/partials/procedure/PostOperative.astro";
import Faq from "@/components/partials/procedure/Faq.astro";
import Gallery from "@/components/partials/procedure/Gallery.astro";
import type { Procedure } from "@/types/procedure";

const { slug } = Astro.params;
const { api } = Astro.locals;

let procedure: Procedure | null = null;

try {
  const { data } = await api.get<{ data: Procedure }>(
    `/api/client/procedure/${slug}`,
  );
  procedure = data.data;
} catch (error) {
  console.error(`Error cargando el procedimiento ${slug}:`, error);
}

if (!procedure) {
  return Astro.redirect(`/${Astro.params.lang || "es"}/404`);
}

// Extraer secciones específicas
const whatIsSection = procedure.section.find((s) => s.type === "what_is");
const techniqueSection = procedure.section.find((s) => s.type === "technique");
const recoverySection = procedure.section.find((s) => s.type === "recovery");
---

<Layout title={`${procedure.title} | Almha`} procedureContext={procedure.title}>
  <Header
    image={procedure.image}
    title={procedure.title}
    subtitle={procedure.subtitle}
    category={procedure.category}
  />

  {whatIsSection && <WhatIs data={whatIsSection} />}

  {
    procedure.preStep && procedure.preStep.length > 0 && (
      <Preparation steps={procedure.preStep} />
    )
  }

  {techniqueSection && <Technique data={techniqueSection} />}

  {
    procedure.phase && procedure.phase.length > 0 && (
      <RecoveryPhase phases={procedure.phase} />
    )
  }

  {recoverySection && <Recovery data={recoverySection} />}

  {
    (procedure.do?.length > 0 || procedure.dont?.length > 0) && (
      <PostOperative
        doList={procedure.do || []}
        dontList={procedure.dont || []}
      />
    )
  }

  {
    procedure.gallery && procedure.gallery.length > 0 && (
      <Gallery images={procedure.gallery} />
    )
  }

  {procedure.faq && procedure.faq.length > 0 && <Faq items={procedure.faq} />}
</Layout>
