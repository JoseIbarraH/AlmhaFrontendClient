---
import Header from "@/components/partials/procedure/Header.astro";
import Layout from "@/layouts/Layout.astro";
import ImgHeader from "@/assets/images/abdominoplastia.jpg";
import Icon from "@/components/ui/Icon.astro";
import type { ApiResponse, Default } from "@/types/apiResponse";
import Grid from "@/components/partials/procedure/Grid.astro";
import Procedures from "@/components/shared/Procedures.astro";

interface Data {
  id: number;
  status: string;
  slug: string;
  image: string;
  title: string;
  subtitle: string;
  category: string;
  category_code: string;
  created_at: string;
}

interface CategoryData {
  title: string;
  code: string;
}

let extractedCategory: CategoryData[] = [];
let procedures: Data[] = [];
let pagination: any = null;

// Get query params
const page = Astro.url.searchParams.get("page") || "1";
const categoryFilter = Astro.url.searchParams.get("category") || "";

try {
  const { api } = Astro.locals;

  // Build API URL with params
  let apiUrl = `api/client/procedures?page=${page}`;
  if (categoryFilter) {
    apiUrl += `&filter[category_code]=${categoryFilter}`;
  }

  const searchParams = Astro.url.searchParams.get("search");
  if (searchParams) {
    apiUrl += `&filter[search]=${searchParams}`;
  }

  const { data } = await api.get<ApiResponse<Default<Data>>>(apiUrl);

  pagination = data.data.pagination;
  procedures = pagination.data;

  extractedCategory = procedures.map((p: Data) => {
    return {
      title: p.category,
      code: p.category_code,
    };
  });

  // Remove duplicates from categories
  extractedCategory = extractedCategory.filter(
    (cat, index, self) => index === self.findIndex((c) => c.code === cat.code),
  );
} catch (error) {
  console.log("Error", error);
}
---

<Layout>
  <section class="relative h-[70vh] overflow-hidden">
    <Header image={ImgHeader.src} />
  </section>

  <section
    class="z-40 bg-[#FFF9F6]/95 backdrop-blur-md border-b-2 border-[#D6C4B6]/30 shadow-lg"
  >
    <div class="max-w-7xl mx-auto px-6 py-4">
      <div class="flex flex-col md:flex-row gap-6 items-center justify-between">
        <!-- Búsqueda -->
        <div class="relative w-full md:w-96">
          <input
            id="search-input"
            type="search"
            value={Astro.url.searchParams.get("search") || ""}
            placeholder="Buscar procedimiento..."
            class="w-full px-5 py-3 pl-12 bg-white border-2 border-[#D6C4B6] rounded-xl text-[#513A31] placeholder-[#7D6A5D] focus:outline-none focus:border-[#FEEBDD] transition-all"
          />
          <Icon
            name="Search"
            class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-[#7D6A5D]"
          />
        </div>

        <!-- Filtros -->
        <div class="relative w-full md:w-auto flex items-center">
          <!-- Botón Izquierda -->
          <button
            id="category-scroll-left"
            type="button"
            class="hidden md:flex absolute -left-5 z-30 p-2 bg-white border border-[#D6C4B6] rounded-full shadow-lg text-[#513A31] hover:bg-[#FEEBDD] transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
            aria-label="Scroll left"
          >
            <Icon name="chevron-left" size={20} />
          </button>

          <!-- Contenedor Scroll -->
          <div
            id="categories-container"
            class="flex gap-3 overflow-x-auto pb-2 md:pb-0 w-full md:w-lg scroll-smooth no-scrollbar px-1 cursor-grab active:cursor-grabbing"
          >
            <a
              href="?page=1"
              class:list={[
                "px-4 py-2 rounded-lg font-medium whitespace-nowrap shrink-0 select-none transition-all",
                !categoryFilter
                  ? "bg-[#513A31] text-[#FEEBDD]"
                  : "border border-[#4a332d] text-[#4a332d] hover:bg-[#4a332d]/10",
              ]}
            >
              Todos
            </a>
            {
              extractedCategory.map((cat: CategoryData) => (
                <a
                  href={`?category=${cat.code}&page=1`}
                  class:list={[
                    "px-6 py-2 rounded-xl border transition-all duration-300 shrink-0 select-none",
                    categoryFilter === cat.code
                      ? "bg-[#513A31] text-[#FEEBDD] border-[#513A31]"
                      : "border-[#4a332d] text-[#4a332d] hover:bg-[#4a332d]/10",
                  ]}
                >
                  {cat.title}
                </a>
              ))
            }
          </div>

          <!-- Botón Derecha -->
          <button
            id="category-scroll-right"
            type="button"
            class="hidden md:flex absolute -right-5 z-30 p-2 bg-white border border-[#D6C4B6] rounded-full shadow-lg text-[#513A31] hover:bg-[#FEEBDD] transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
            aria-label="Scroll right"
          >
            <Icon name="chevron-right" size={20} />
          </button>
        </div>
      </div>
    </div>
  </section>

  <div>
    <Grid
      procedures={procedures}
      pagination={pagination}
      categoryFilter={categoryFilter}
    />
  </div>
</Layout>

<script>
  function initSearch() {
    const searchInput = document.getElementById(
      "search-input",
    ) as HTMLInputElement;

    if (!searchInput) return;

    let timeout: NodeJS.Timeout;

    searchInput.addEventListener("input", (e) => {
      const target = e.target as HTMLInputElement;
      clearTimeout(timeout);

      timeout = setTimeout(() => {
        const url = new URL(window.location.href);
        const term = target.value.trim();

        if (term) {
          url.searchParams.set("search", term);
        } else {
          url.searchParams.delete("search");
        }

        // Reset page to 1 on new search
        url.searchParams.set("page", "1");

        window.location.href = url.toString();
      }, 500);
    });
  }

  // Initialize on load and page swaps
  initSearch();
  document.addEventListener("astro:page-load", initSearch);
</script>

<script>
  function initScroll() {
    const container = document.getElementById("categories-container");
    const leftBtn = document.getElementById(
      "category-scroll-left",
    ) as HTMLButtonElement | null;
    const rightBtn = document.getElementById(
      "category-scroll-right",
    ) as HTMLButtonElement | null;

    if (!container || !leftBtn || !rightBtn) {
      console.warn("Scroll elements not found");
      return;
    }

    // Scroll con botones
    const scrollAmount = 200;

    const scrollLeftHandler = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      console.log("Scroll left clicked");
      container.scrollLeft -= scrollAmount;
    };

    const scrollRightHandler = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      console.log("Scroll right clicked");
      container.scrollLeft += scrollAmount;
    };

    // Usar addEventListener para mayor seguridad
    leftBtn.replaceWith(leftBtn.cloneNode(true));
    rightBtn.replaceWith(rightBtn.cloneNode(true));

    // Re-obtener referencias frescas después del replaceWith
    const newLeftBtn = document.getElementById(
      "category-scroll-left",
    ) as HTMLButtonElement;
    const newRightBtn = document.getElementById(
      "category-scroll-right",
    ) as HTMLButtonElement;

    newLeftBtn.addEventListener("click", scrollLeftHandler);
    newRightBtn.addEventListener("click", scrollRightHandler);

    // Drag to scroll con mouse
    let isDown = false;
    let startX: number;
    let scrollLeft: number;

    const onMouseDown = (e: MouseEvent) => {
      isDown = true;
      container.classList.add("active");
      startX = e.pageX - container.offsetLeft;
      scrollLeft = container.scrollLeft;
      container.style.scrollBehavior = "auto";
    };

    const onMouseLeave = () => {
      isDown = false;
      container.classList.remove("active");
      container.style.scrollBehavior = "smooth";
    };

    const onMouseUp = () => {
      isDown = false;
      container.classList.remove("active");
      container.style.scrollBehavior = "smooth";
    };

    const onMouseMove = (e: MouseEvent) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - container.offsetLeft;
      const walk = (x - startX) * 2;
      container.scrollLeft = scrollLeft - walk;
    };

    // Eliminar listeners previos si existen (aunque clones ya lo hacen)
    // Se agregan nuevos
    container.onmousedown = onMouseDown;
    container.onmouseleave = onMouseLeave;
    container.onmouseup = onMouseUp; // Ojo: window mouseup es mejor, pero mantenemos simple por ahora
    container.onmousemove = onMouseMove;

    // Window mouseup extra para soltar fuera
    window.addEventListener("mouseup", () => {
      isDown = false;
      container.classList.remove("active");
      container.style.scrollBehavior = "smooth";
    });

    // Control de visibilidad de botones mejorado
    const updateButtons = () => {
      const { scrollLeft, scrollWidth, clientWidth } = container;

      // Si el contenido cabe completamente, ocultar ambos botones
      if (scrollWidth <= clientWidth + 2) {
        newLeftBtn.style.display = "none";
        newRightBtn.style.display = "none";
        return;
      }

      // Mostrar botones solo en desktop
      newLeftBtn.style.display = "flex";
      newRightBtn.style.display = "flex";

      // Deshabilitar botón izquierdo si está al inicio
      if (scrollLeft <= 5) {
        newLeftBtn.disabled = true;
        newLeftBtn.style.opacity = "0";
        newLeftBtn.style.pointerEvents = "none";
      } else {
        newLeftBtn.disabled = false;
        newLeftBtn.style.opacity = "1";
        newLeftBtn.style.pointerEvents = "auto";
      }

      // Deshabilitar botón derecho si está al final
      const isAtEnd = scrollLeft + clientWidth >= scrollWidth - 5;
      if (isAtEnd) {
        newRightBtn.disabled = true;
        newRightBtn.style.opacity = "0";
        newRightBtn.style.pointerEvents = "none";
      } else {
        newRightBtn.disabled = false;
        newRightBtn.style.opacity = "1";
        newRightBtn.style.pointerEvents = "auto";
      }
    };

    // Listeners para actualizar botones
    container.addEventListener("scroll", updateButtons);
    window.addEventListener("resize", updateButtons);

    // Actualizar inmediatamente
    setTimeout(updateButtons, 50);
    setTimeout(updateButtons, 500);
  }

  // Ejecutar en carga inicial y navegaciones de Astro
  initScroll();
  document.addEventListener("astro:page-load", initScroll);
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Transición suave para los botones */
  #category-scroll-left,
  #category-scroll-right {
    transition:
      opacity 0.3s ease,
      transform 0.2s ease;
  }

  #category-scroll-left:hover:not(:disabled),
  #category-scroll-right:hover:not(:disabled) {
    transform: scale(1.1);
  }
</style>
