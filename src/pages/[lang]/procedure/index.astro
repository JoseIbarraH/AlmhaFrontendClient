---
import HeaderList from "@/components/partials/procedure/HeaderList.astro";
import Layout from "@/layouts/Layout.astro";
import ImgHeader from "@/assets/images/abdominoplastia.jpg";
import Icon from "@/components/ui/Icon.astro";
import Grid from "@/components/partials/procedure/Grid.astro";
import CategoryList from "@/components/partials/procedure/CategoryList.astro";
import SearchInput from "@/components/ui/SearchInput.astro";
import CtaStep from "@/components/shared/CtaStep.astro";
import { fetchListData } from "@/lib/dataService";
import type { Data, CategoryData } from "@/types/procedure";
import { loadTranslations } from "@/lib/i18n";

const lang = Astro.currentLocale || "es";
const t = await loadTranslations(lang);

let extractedCategory: CategoryData[] = [];
let procedures: Data[] = [];
let pagination: any = null;

// Get query params
const categoryFilter = Astro.url.searchParams.get("category") || "";

try {
  const { api } = Astro.locals;

  const {
    items,
    categories,
    pagination: pagResult,
  } = await fetchListData<Data>({
    api,
    endpoint: "api/client/procedure",
    searchParams: Astro.url.searchParams,
  });

  procedures = items;
  extractedCategory = categories;
  pagination = pagResult;
} catch (error) {
  console.log("Error", error);
}
---

<Layout>
  <section class="relative h-[70vh] overflow-hidden">
    <HeaderList image={ImgHeader.src} />
  </section>

  <section
    class="z-40 bg-[#FFF9F6]/95 backdrop-blur-md border-b-2 border-[#D6C4B6]/30 shadow-lg"
  >
    <div class="max-w-7xl mx-auto px-6 py-4">
      <div class="flex flex-col md:flex-row gap-6 items-center justify-between">
        <!-- Búsqueda -->
        <SearchInput
          placeholder={t.procedure.search.placeholder}
          class="md:w-96"
        />

        <!-- Filtros -->
        <CategoryList
          categories={extractedCategory}
          activeCategory={categoryFilter}
          t={t}
        />
      </div>
    </div>
  </section>

  <div>
    <Grid procedures={procedures} pagination={pagination} />
  </div>

  <div>
    <CtaStep />
  </div>
</Layout>
