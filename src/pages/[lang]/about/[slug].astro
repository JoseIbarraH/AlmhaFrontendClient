---
import Layout from "@/layouts/Layout.astro";
import type { ApiResponse } from "@/types/apiResponse";
import type { Data } from "@/types/member";
import { X } from "@lucide/astro";
import { loadTranslations } from "@/lib/i18n";

const { slug, lang } = Astro.params;
const t = await loadTranslations(lang || "es");
const { api } = Astro.locals;
let member: Data | null = null;

try {
  const { data } = await api.get<ApiResponse<Data>>(`api/client/members/${slug}`);
  member = data.data;
} catch (error) {
  console.error("Error fetching member:", error);
  return Astro.redirect("/404");
}

if (!member) {
  return Astro.redirect("/404");
}
---

<Layout title={`${member.name} - Almha`}>
  <div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8 bg-[#FFF9F6]">
    <div class="max-w-6xl mx-auto">

      <!-- Sección Principal del Perfil -->
      <div class="bg-white rounded-3xl shadow-xl overflow-hidden mb-8">
        <div class="md:flex">
          <!-- Imagen del Miembro -->
          <div class="md:w-2/5 relative">
            <img
              src={member.image}
              alt={member.name}
              class="w-full h-full object-cover min-h-[400px]"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-linear-to-t from-[#513A31]/90 to-transparent p-6">
              <div class="inline-block bg-[#FEEBDD] text-[#513A31] px-4 py-2 rounded-full text-sm font-medium">
                {member.status === 'active' ? t?.team?.certified_specialist : member.status}
              </div>
            </div>
          </div>

          <!-- Información del Miembro -->
          <div class="md:w-3/5 p-8 md:p-12">
            <div class="border-l-4 border-[#7D6A5D] pl-6 mb-6">
              <h1 class="text-4xl md:text-5xl font-bold text-[#513A31] mb-2">
                {member.name}
              </h1>
              <p class="text-xl text-[#7D6A5D] font-medium">
                {member.specialization}
              </p>
            </div>

            <!-- Biografía -->
            <div class="mb-8">
              <h2 class="text-2xl font-bold text-[#513A31] mb-4 flex items-center">
                <span class="w-2 h-8 bg-[#7D6A5D] rounded-full mr-3"></span>
                {t?.team?.biography}
              </h2>
              <div class="text-[#7D6A5D] leading-relaxed prose prose-brown group-hover:text-[#513A31] transition-colors" set:html={member.biography}></div>
            </div>

            <!-- Especialización (Static header, dynamic content?) The data only gives a string 'specialization' which is used above.
                 The user asked not to modify the design much. I will render the specialization description here if available,
                 or simply omit this block if it's redundant.
                 However, `member.description` is available. Let's use that one here?
                 The HTML had "Áreas de Especialización" box. I'll put member.description there for now. -->
            {member.description && (
              <div class="bg-[#FEEBDD] rounded-2xl p-6">
                 <h2 class="text-xl font-bold text-[#513A31] mb-4">{t?.team?.about_me}</h2>
                 <p class="text-[#513A31]">{member.description}</p>
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- Galería de Resultados -->
      {member.results && member.results.length > 0 && (
        <div class="bg-white rounded-3xl shadow-xl p-8 md:p-12">
          <div class="mb-8">
            <h2 class="text-3xl font-bold text-[#513A31] mb-2 flex items-center">
              <span class="w-3 h-10 bg-[#7D6A5D] rounded-full mr-4"></span>
              {t?.team?.gallery?.title}
            </h2>
            <p class="text-[#7D6A5D] ml-7">
              {t?.team?.gallery?.subtitle}
            </p>
          </div>

          <div class="relative group/carousel">
            <!-- Botón Izquierdo -->
            <button
              id="prevBtn"
              class="hidden absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 z-10 bg-white/90 p-3 rounded-full shadow-lg text-[#7D6A5D] hover:text-[#513A31] hover:bg-white transition-all duration-300 backdrop-blur-sm cursor-pointer border border-[#FEEBDD]"
              aria-label="Anterior"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6"/>
              </svg>
            </button>

            <!-- Contenedor Scroll -->
            <div
              id="galleryContainer"
              class="grid grid-rows-2 grid-flow-col gap-6 overflow-x-auto scrollbar-hide scroll-smooth pb-4 snap-x snap-mandatory"
            >
              {member.results.map((result) => (
                <div class="w-[300px] snap-center group relative overflow-hidden rounded-2xl bg-[#FEEBDD] shrink-0 cursor-zoom-in gallery-item" data-full-img={result.path} data-description={result.description || ''}>
                  <img
                    src={result.path}
                    alt={result.description || "Resultado paciente"}
                    class="w-full h-72 object-cover transition-transform duration-300 group-hover:scale-105 pointer-events-none"
                  />
                  {result.description && (
                    <div class="p-5">
                      <p class="text-sm text-[#7D6A5D] leading-relaxed">
                        {result.description}
                      </p>
                    </div>
                  )}
                </div>
              ))}
            </div>

            <!-- Botón Derecho -->
            <button
              id="nextBtn"
              class="hidden absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 z-10 bg-white/90 p-3 rounded-full shadow-lg text-[#7D6A5D] hover:text-[#513A31] hover:bg-white transition-all duration-300 backdrop-blur-sm cursor-pointer border border-[#FEEBDD]"
              aria-label="Siguiente"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m9 18 6-6-6-6"/>
              </svg>
            </button>
          </div>

          <!-- Modal -->
          <div
            id="imageModal"
            class="fixed inset-0 z-50 bg-black/90 hidden items-center justify-center p-4 backdrop-blur-sm opacity-0 transition-opacity duration-300"
          >
            <button
              id="closeModalBtn"
              class="absolute top-4 right-4 text-white/70 hover:text-white transition-colors p-2 z-50"
            >
              <X class="size-8 cursor-pointer" />
            </button>
            <div class="flex flex-col items-center max-w-5xl w-full">
                <img
                  id="modalImage"
                  src=""
                  alt="Vista previa"
                  class="max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl scale-95 transition-transform duration-300"
                />
                <p id="modalDescription" class="mt-4 text-white/90 text-lg text-center font-medium max-w-3xl"></p>
            </div>
          </div>

          <script>
            const container = document.getElementById('galleryContainer');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            // Modal elements
            const modal = document.getElementById('imageModal');
            const modalImage = document.getElementById('modalImage') as HTMLImageElement | null;
            const modalDescription = document.getElementById('modalDescription');
            const closeModalBtn = document.getElementById('closeModalBtn');
            const galleryItems = document.querySelectorAll('.gallery-item');

            // Carousel Logic
            if (container && prevBtn && nextBtn) {
              const checkScroll = () => {
                const isAtStart = container.scrollLeft <= 5;
                const isAtEnd = container.scrollLeft + container.clientWidth >= container.scrollWidth - 5;
                const hasOverflow = container.scrollWidth > container.clientWidth;

                if (hasOverflow) {
                  prevBtn.style.display = isAtStart ? 'none' : 'block';
                  nextBtn.style.display = isAtEnd ? 'none' : 'block';
                } else {
                  prevBtn.style.display = 'none';
                  nextBtn.style.display = 'none';
                }
              };

              prevBtn.addEventListener('click', () => {
                const scrollAmount = window.innerWidth < 768 ? 300 : 600;
                container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
              });

              nextBtn.addEventListener('click', () => {
                const scrollAmount = window.innerWidth < 768 ? 300 : 600;
                container.scrollBy({ left: 320, behavior: 'smooth' });
              });

              container.addEventListener('scroll', checkScroll);
              window.addEventListener('resize', checkScroll);
              checkScroll();
            }

            // Modal Logic
            if (modal && modalImage && modalDescription && closeModalBtn) {
                const openModal = (src: string, desc: string) => {
                    modalImage.src = src;
                    modalDescription.textContent = desc;
                    modal.classList.remove("hidden");

                    requestAnimationFrame(() => {
                        modal.classList.remove("opacity-0");
                        modal.classList.add("flex");
                        modalImage.classList.remove("scale-95");
                        modalImage.classList.add("scale-100");
                    });
                    document.body.style.overflow = 'hidden';
                };

                const closeModal = () => {
                    modal.classList.add("opacity-0");
                    modalImage.classList.add("scale-95");
                    modalImage.classList.remove("scale-100");

                    setTimeout(() => {
                        modal.classList.add("hidden");
                        modal.classList.remove("flex");
                        modalImage.src = "";
                         document.body.style.overflow = '';
                    }, 300);
                };

                galleryItems.forEach(item => {
                    item.addEventListener('click', () => {
                        const imgPath = item.getAttribute('data-full-img');
                        const desc = item.getAttribute('data-description');
                        if (imgPath) openModal(imgPath, desc || '');
                    });
                });

                closeModalBtn.addEventListener('click', closeModal);

                modal.addEventListener("click", (e) => {
                  if (e.target === modal) closeModal();
                });

                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
                        closeModal();
                    }
                });
            }
          </script>

          <style>
            .scrollbar-hide::-webkit-scrollbar {
                display: none;
            }
            .scrollbar-hide {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
          </style>

          <!-- Nota Disclaimer -->
          <div class="mt-8 bg-[#D6C4B6]/30 border-l-4 border-[#7D6A5D] rounded-lg p-6">
            <p class="text-sm text-[#513A31] leading-relaxed" set:html={t?.team?.results_disclaimer}>
            </p>
          </div>
        </div>
      )}

      <!-- Llamado a la Acción -->
      <div class="mt-8 bg-linear-to-r from-[#513A31] to-[#7D6A5D] rounded-3xl p-8 md:p-12 text-center">
        <h2 class="text-3xl font-bold text-[#FFF9F6] mb-4">
          {t?.team?.cta?.title}
        </h2>
        <p class="text-[#FEEBDD] mb-6 max-w-2xl mx-auto leading-relaxed">
          {t?.team?.cta?.description.replace('{name}', member.name)}
        </p>
        <button class="bg-[#FEEBDD] text-[#513A31] px-8 py-4 rounded-full font-bold text-lg hover:bg-[#FFF9F6] transition-colors duration-300 shadow-lg cursor-pointer">
          {t?.team?.cta?.button}
        </button>
      </div>

    </div>
  </div>
</Layout>
