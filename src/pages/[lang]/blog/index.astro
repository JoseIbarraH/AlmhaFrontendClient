---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/partials/blog/Header.astro";
import ImgHeader from "@/assets/images/test/abdominoplastia.jpg";
import Icon from "@/components/ui/Icon.astro";
import { fetchListData } from "@/lib/dataService";
import Grid from "@/components/partials/blog/Grid.astro";
import type { Data, CategoryData } from "@/types/blog";
import type { PaginatedResponse } from "@/types/apiResponse";
import { loadTranslations } from "@/lib/i18n";
import CategoryList from "@/components/partials/blog/CategoryList.astro";
import SearchInput from "@/components/ui/SearchInput.astro";
import Newsletter from "@/components/partials/blog/Newsletter.astro";
import RecentArticles from "@/components/partials/blog/RecentArticles.astro";

const lang = Astro.currentLocale || "es";
const t = await loadTranslations(lang);

let extractedCategory: CategoryData[] = [];
let blogs: Data[] = [];
let keyBlogs: Data[] = [];
let pagination: PaginatedResponse<Data> | null = null;

const categoryFilter = Astro.url.searchParams.get("category") || "";
const sort = Astro.url.searchParams.get("sort") || "";

try {
  const { api } = Astro.locals;

  const {
    items,
    categories,
    pagination: pagResult,
    last_three,
  } = await fetchListData<Data>({
    api,
    endpoint: "api/client/blog",
    searchParams: Astro.url.searchParams,
  });

  blogs = items;
  extractedCategory = categories;
  pagination = pagResult;
  keyBlogs = last_three || [];
} catch (error) {
  console.error("Error", error);
}

---

<Layout>
  <div class="bg-[#FFF9F6]">
    <!-- Hero Section -->
    <section class="relative h-[70vh] overflow-hidden">
      <Header image={ImgHeader.src} t={t} />
    </section>

    <!-- Main Content -->
    <section class="max-w-7xl mx-auto py-16 px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        <!-- Columna Principal - Artículos -->
        <div class="lg:col-span-8">
          <!-- Header de sección -->
          <div class="mb-8">
            <div class="flex items-center justify-between mb-6">
              <div>
                <h2 class="text-3xl font-bold text-[#513A31] font-serif mb-2">
                  Mira todos los articulos aquí
                </h2>
              </div>

              <!-- Ordenar por -->
              <div class="hidden md:block">
                <select
                  id="sort-select"
                  class="px-4 py-2 bg-[#FFF9F6] border-2 border-[#D6C4B6] rounded-lg text-[#513A31] font-medium focus:outline-none focus:border-[#FEEBDD] transition-colors"
                  value={sort}
                >
                  <option value="-created_at">Más recientes</option>
                  <option value="created_at">Más antiguos</option>
                  <option value="-views">Más leídos</option>
                </select>
              </div>
            </div>

            <!-- Barra de búsqueda -->
            <div class="relative">
              <SearchInput placeholder={t.blog.search.placeholder} />
              <Icon
                name="search"
                class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-[#7D6A5D]"
              />
            </div>
          </div>

          <!-- Grid de Cards -->
          <div>
            <Grid
              blogs={blogs}
              pagination={pagination}
              categoryFilter={categoryFilter}
            />
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-4 space-y-8">
          <!-- Categorías -->
          <div>
            <CategoryList
              categories={extractedCategory}
              activeCategory={categoryFilter}
              t={t}
            />
          </div>

          <!-- Newsletter -->
          <Newsletter />

          <!-- Artículos Recientes -->
          <RecentArticles blogs={keyBlogs} lang={lang} t={t} />
        </aside>
      </div>
    </section>
  </div>
</Layout>

<script>
  const sortSelect = document.getElementById(
    "sort-select",
  ) as HTMLSelectElement;

  if (sortSelect) {
    // Set initial value from URL
    const urlParams = new URLSearchParams(window.location.search);
    const currentSort = urlParams.get("sort");
    if (currentSort) {
      sortSelect.value = currentSort;
    }

    sortSelect.addEventListener("change", (e) => {
      const target = e.target as HTMLSelectElement;
      const value = target.value;

      const searchParams = new URLSearchParams(window.location.search);
      searchParams.set("sort", value);

      // Reset page to 1 when sorting changes
      searchParams.delete("page");

      window.location.search = searchParams.toString();
    });
  }
</script>
